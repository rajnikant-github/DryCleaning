<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- V1 targets Android and iOS only -->
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>DryCleaning</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- XAML source generation (compiled bindings everywhere via x:DataType). -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>EDry Cleaners</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.drycleaning</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B3A6B"/>

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1B3A6B" BaseSize="128,128"/>

        <!-- Images -->
        <MauiImage Include="Resources\Images\*"/>
        <MauiImage Update="Resources\Images\tab_*.svg" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\ic_*.svg" BaseSize="24,24"/>
        <MauiImage Update="Resources\Images\logo_*.svg" BaseSize="64,64"/>

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*"/>

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <!-- App configuration: currency, VAT, feature flags, API URL -->
        <EmbeddedResource Include="appsettings.json" LogicalName="DryCleaning.appsettings.json" />
        <!-- Environment overrides written by ./set-app-env.sh (git-ignored). Values here win over appsettings.json. -->
        <EmbeddedResource Include="appsettings.env.json" LogicalName="DryCleaning.appsettings.env.json" Condition="Exists('appsettings.env.json')" />
        <EmbeddedResource Include="appsettings.json" LogicalName="DryCleaning.appsettings.json" />
        <!-- Environment overrides written by ./set-app-env.sh (git-ignored). Values here win over appsettings.json. -->
        <EmbeddedResource Include="appsettings.env.json" LogicalName="DryCleaning.appsettings.env.json" Condition="Exists('appsettings.env.json')" />
        <!-- Keys of the chosen environment, copied by ./set-app-env.sh from environments/<name>.secrets.json (git-ignored). Merged last. -->
        <EmbeddedResource Include="appsettings.secrets.json" LogicalName="DryCleaning.appsettings.secrets.json" Condition="Exists('appsettings.secrets.json')" />

    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
    </ItemGroup>

</Project>
