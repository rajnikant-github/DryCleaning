<?xml version="1.0" encoding="utf-8" ?>
<!--  Change password (all roles, from Profile)  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Auth"
                x:Class="DryCleaning.Views.Auth.ChangePasswordPage"
                x:DataType="vm:ChangePasswordViewModel"
                Title="Change Password">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">
                <Border Style="{StaticResource HeroCard}" Padding="18">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="52" HeightRequest="52" BackgroundColor="{StaticResource White}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Image Source="ic_lock.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Keep your account secure" Style="{StaticResource HeroEyebrow}" />
                            <Label Text="Choose a password that's unique to you." Style="{StaticResource HeroBody}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Current password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding CurrentPassword}" Placeholder="Current password" IsPassword="{Binding IsPasswordHidden}" MaxLength="100" />
                            <Label Grid.Column="1" Text="{Binding PasswordToggleText}" Style="{StaticResource LinkLabel}" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="New password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry Text="{Binding NewPassword}" Placeholder="New password" IsPassword="{Binding IsPasswordHidden}" MaxLength="100" />
                    </Border>
                    <Label Text="{Binding PasswordHint}" Style="{StaticResource Small}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Confirm new password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry Text="{Binding ConfirmPassword}" Placeholder="Type it again" IsPassword="{Binding IsPasswordHidden}" MaxLength="100" />
                    </Border>
                </VerticalStackLayout>
                <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource ErrorSoft}" IsVisible="{Binding HasValidationMessage}">
                    <Label Text="{Binding ValidationMessage}" TextColor="{StaticResource ErrorDark}" FontSize="13" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 24,24,0,0" Padding="20,16,20,20">
            <Grid>
                <Button Text="Change Password" Command="{Binding SaveCommand}" IsVisible="{Binding IsNotBusy}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="52" />
            </Grid>
        </Border>
    </Grid>
</views:BasePage>
