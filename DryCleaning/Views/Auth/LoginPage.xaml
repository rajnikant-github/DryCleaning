<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Auth"
                x:Class="DryCleaning.Views.Auth.LoginPage"
                x:DataType="vm:LoginViewModel"
                Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout>
            <VerticalStackLayout Padding="{OnPlatform iOS='24,56,24,0', Default='24,24,24,0'}" Spacing="24">
                <HorizontalStackLayout Spacing="10">
                    <Border WidthRequest="38" HeightRequest="38" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                        <Image Source="logo_mark.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="EDry Cleaners" Style="{StaticResource H3}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border Style="{StaticResource HeroCard}" Padding="24">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding RoleTitle}" Style="{StaticResource HeroEyebrow}" />
                        <Label Text="Welcome back." Style="{StaticResource HeroTitle}" FontSize="30" />
                        <Label Text="A fresh day starts here. Sign in to continue." Style="{StaticResource HeroBody}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Padding="24,24" Spacing="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mobile number or email" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image Source="ic_phone.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding Identifier}" Placeholder="+27 82 555 0142"
                                   Keyboard="Email" ReturnType="Next" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Image Source="ic_lock.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding Password}" Placeholder="Enter your password"
                                   IsPassword="{Binding IsPasswordHidden}" ReturnType="Go"
                                   ReturnCommand="{Binding LoginCommand}" />
                            <Label Grid.Column="2" Text="{Binding PasswordToggleText}" Style="{StaticResource LinkLabel}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextColor="{StaticResource ErrorDark}" FontSize="14" />

                <Button Text="Forgot password?" Style="{StaticResource TextButton}" HorizontalOptions="Start"
                        Command="{Binding ForgotPasswordCommand}" />

                <Grid>
                    <Button Text="Sign in" Command="{Binding LoginCommand}" IsVisible="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="52" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                    <BoxView Style="{StaticResource Divider}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="or" Style="{StaticResource Small}" />
                    <BoxView Grid.Column="2" Style="{StaticResource Divider}" VerticalOptions="Center" />
                </Grid>

                <Button Text="Continue with a one-time code" Style="{StaticResource OutlineButton}" Command="{Binding ContinueWithOtpCommand}" />

                <VerticalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,8,0,0">
                    <Label Text="New to EDry Cleaners?" HorizontalOptions="Center" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Label Text="Create account" HorizontalOptions="Center" Style="{StaticResource LinkLabel}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CreateAccountCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <Button Text="Change role" Style="{StaticResource TextButton}" TextColor="{StaticResource MutedForeground}"
                        HorizontalOptions="Center" Command="{Binding ChangeRoleCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
