<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Auth"
                x:Class="DryCleaning.Views.Auth.LoginPage"
                x:DataType="vm:LoginViewModel"
                Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout>
            <!--  Header band  -->
            <Grid BackgroundColor="{DynamicResource Primary}" HeightRequest="{OnPlatform iOS=220, Default=196}">
                <Ellipse WidthRequest="190" HeightRequest="190" Fill="{StaticResource HeaderOverlayBrush}"
                         HorizontalOptions="End" VerticalOptions="Start" Margin="0,-40,-40,0" />
                <VerticalStackLayout VerticalOptions="End" Padding="24,0,24,24" Spacing="4">
                    <Label Text="{Binding RoleTitle}" Style="{StaticResource HeaderCaption}" />
                    <Label Text="Welcome back" Style="{StaticResource H1}" TextColor="{StaticResource White}" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="24,28" Spacing="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mobile number or email" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="&#xf095;" VerticalOptions="Center"  FontFamily="FA" WidthRequest="24" HorizontalTextAlignment="Center"/>
                            <Entry Grid.Column="1" Text="{Binding Identifier}" Placeholder="+27 82 555 0142"
                                   Keyboard="Email" ReturnType="Next" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="&#xf023;" VerticalOptions="Center"  FontFamily="FA" WidthRequest="24" HorizontalTextAlignment="Center"/>
                            <Entry Grid.Column="1" Text="{Binding Password}" Placeholder="Enter your password"
                                   IsPassword="{Binding IsPasswordHidden}" ReturnType="Go"
                                   ReturnCommand="{Binding LoginCommand}" />
                            <Label Grid.Column="2" Text="{Binding PasswordToggleText}" Style="{StaticResource LinkLabel}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextColor="{StaticResource ErrorDark}" FontSize="14" />

                <Button Text="Forgot password?" Style="{StaticResource TextButton}" HorizontalOptions="Start"
                        Command="{Binding ForgotPasswordCommand}" />

                <Grid>
                    <Button Text="Login" Command="{Binding LoginCommand}" IsVisible="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="52" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                    <BoxView Style="{StaticResource Divider}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="or" Style="{StaticResource Small}" />
                    <BoxView Grid.Column="2" Style="{StaticResource Divider}" VerticalOptions="Center" />
                </Grid>

                <Button Text="Continue with OTP" ContentLayout="Left,8" Style="{StaticResource OutlineButton}" Command="{Binding ContinueWithOtpCommand}" >
                    <Button.ImageSource><FontImageSource FontFamily="FA" Glyph="&#xf3cf;" Size="16" Color="{StaticResource AppForeground}" /></Button.ImageSource>
                </Button>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,8,0,0">
                    <Label Text="New to EDry Cleaners?" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Label Text="Create account" Style="{StaticResource LinkLabel}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CreateAccountCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <Button Text="Change role" Style="{StaticResource TextButton}" TextColor="{StaticResource MutedForeground}"
                        HorizontalOptions="Center" Command="{Binding ChangeRoleCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
