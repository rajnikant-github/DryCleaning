<?xml version="1.0" encoding="utf-8" ?>
<!--  Forgot password: request a code, then set a new password  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Auth"
                x:Class="DryCleaning.Views.Auth.ForgotPasswordPage"
                x:DataType="vm:ForgotPasswordViewModel"
                Title="Reset password">
    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="20">
            <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}" WidthRequest="64" HeightRequest="64">
                <Label Text="&#xf084;" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{StaticResource InfoDark}"/>
            </Border>

            <!--  Step 1: where to send the code  -->
            <VerticalStackLayout Spacing="18" IsVisible="{Binding IsRequestStep}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Forgot your password?" Style="{StaticResource H1}" />
                    <Label Text="Enter the email on your account. We'll email you a 6-digit code."
                           Style="{StaticResource Caption}" FontSize="15" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry Text="{Binding Identifier}" Placeholder="you@example.com" Keyboard="Email" ReturnType="Send"
                               ReturnCommand="{Binding SendCodeCommand}" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!--  Step 2: code + new password  -->
            <VerticalStackLayout Spacing="18" IsVisible="{Binding IsCodeSent}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Set a new password" Style="{StaticResource H1}" />
                    <Label Style="{StaticResource Caption}" FontSize="15">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Enter the 6-digit code sent to " />
                                <Span Text="{Binding Destination}" FontFamily="AppSemibold" TextColor="{StaticResource AppForeground}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <controls:OtpView Code="{Binding Code}" />


                <VerticalStackLayout Spacing="6">
                    <Label Text="New password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding NewPassword}" Placeholder="New password" IsPassword="{Binding IsPasswordHidden}" MaxLength="100" />
                            <Label Grid.Column="1" Text="{Binding PasswordToggleText}" Style="{StaticResource LinkLabel}" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                    <Label Text="{Binding PasswordHint}" Style="{StaticResource Small}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Confirm new password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry Text="{Binding ConfirmPassword}" Placeholder="Type it again" IsPassword="{Binding IsPasswordHidden}" MaxLength="100" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Label Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextColor="{StaticResource ErrorDark}" FontSize="14" />

            <Grid>
                <VerticalStackLayout IsVisible="{Binding IsNotBusy}" Spacing="8">
                    <Button Text="Send code" Command="{Binding SendCodeCommand}" IsVisible="{Binding IsRequestStep}" />
                    <Button Text="Reset password" Command="{Binding ResetCommand}" IsVisible="{Binding IsCodeSent}" />
                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsCodeSent}">
                        <Button Text="Resend code" Style="{StaticResource TextButton}" HorizontalOptions="Start" Command="{Binding SendCodeCommand}" />
                        <Button Grid.Column="1" Text="Use a different email" Style="{StaticResource TextButton}" HorizontalOptions="End"
                                Command="{Binding ChangeIdentifierCommand}" />
                    </Grid>
                </VerticalStackLayout>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="52" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
