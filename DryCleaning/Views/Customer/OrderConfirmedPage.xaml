<?xml version="1.0" encoding="utf-8" ?>
<!--  C15 – Order confirmed  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:services="clr-namespace:DryCleaning.Services"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Customer"
                x:Class="DryCleaning.Views.Customer.OrderConfirmedPage"
                x:DataType="vm:OrderConfirmedViewModel"
                Title="Order Confirmed">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <Grid RowDefinitions="*,Auto">
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="20" Spacing="16">
                <Border WidthRequest="96" HeightRequest="96" StrokeShape="RoundRectangle 48" StrokeThickness="0"
                        BackgroundColor="{StaticResource SuccessSoft}" HorizontalOptions="Center" Margin="0,24,0,0">
                    <Label Text="✓" FontSize="48" TextColor="{StaticResource Success}" FontFamily="AppSemibold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Order placed!" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />
                <Label Text="Payment received. We've sent your order to the provider and will let you know when a driver is on the way."
                       Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                        <Label Text="Order" Style="{StaticResource Caption}" />
                        <Label Grid.Column="1" Text="{Binding OrderNumber}" Style="{StaticResource BodyMedium}" HorizontalOptions="End" />
                        <Label Grid.Row="1" Text="Provider" Style="{StaticResource Caption}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ProviderName}" FontSize="14" HorizontalOptions="End" />
                        <Label Grid.Row="2" Text="Pickup" Style="{StaticResource Caption}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding PickupText}" FontSize="14" HorizontalOptions="End" HorizontalTextAlignment="End" />
                        <Label Grid.Row="3" Text="Est. delivery" Style="{StaticResource Caption}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding EstimatedCompletionText}" FontSize="14" HorizontalOptions="End" />
                        <Label Grid.Row="4" Text="{Binding ItemCountText, StringFormat='Paid ({0})'}" Style="{StaticResource Caption}" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Total, Converter={StaticResource Currency}}" Style="{StaticResource BodyMedium}"
                               TextColor="{StaticResource Primary}" HorizontalOptions="End" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource InfoSoft}">
                    <Label Text="{Binding AddressText, StringFormat='📍 Pickup from {0}'}" TextColor="{StaticResource InfoDark}" FontSize="13" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="1" IsVisible="{Binding IsContent}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeShape="Rectangle" Padding="16,12,16,20">
            <VerticalStackLayout Spacing="10">
                <Button Text="Track Order" Command="{Binding TrackOrderCommand}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="View Details" Command="{Binding ViewOrderCommand}" Style="{StaticResource OutlineButton}" />
                    <Button Grid.Column="1" Text="Back to Home" Command="{Binding GoHomeCommand}" Style="{StaticResource SecondaryButton}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:BasePage>
