<?xml version="1.0" encoding="utf-8" ?>
<!--  C05 – Customer Home  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Customer"
                x:Class="DryCleaning.Views.Customer.CustomerHomePage"
                x:DataType="vm:CustomerHomeViewModel"
                Title="EDry Cleaners">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Alerts" IconImageSource="ic_bell.png" Command="{Binding OpenNotificationsCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <RefreshView IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="22" Padding="0,12,0,28">

                    <!--  Header  -->
                    <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="20,0">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Greeting}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding FirstName}" Style="{StaticResource H1}" FontSize="30" />
                            <Border BackgroundColor="{StaticResource White}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16" Padding="14,12" Margin="0,10,0,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeAddressCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Border Style="{StaticResource IconTile}" WidthRequest="36" HeightRequest="36" BackgroundColor="{StaticResource PrimarySoft}">
                                        <Label Text="📍" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="PICKUP ADDRESS" TextColor="{StaticResource MutedForeground}" FontSize="10" CharacterSpacing="0.8" FontFamily="AppSemibold" />
                                        <Label Text="{Binding AddressText}" TextColor="{StaticResource AppForeground}" FontSize="13"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="Change" TextColor="{StaticResource PrimaryDark}" FontSize="12"
                                           FontFamily="AppSemibold" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Quick order  -->
                    <Border Margin="20,0" Style="{StaticResource HeroCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding QuickOrderCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="A LITTLE CARE. A FRESH START." Style="{StaticResource HeroEyebrow}" FontSize="10" />
                                <Label Text="Laundry day,&#10;taken care of." Style="{StaticResource HeroTitle}" />
                                <Label Text="Expert care, collected and delivered to your door." Style="{StaticResource HeroBody}" />
                                <Border BackgroundColor="{StaticResource White}" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                        Padding="16,11" HorizontalOptions="Start" Margin="0,8,0,0">
                                    <Label Text="Schedule a pickup  →" TextColor="{StaticResource PrimaryDark}" FontSize="13" FontFamily="AppSemibold" />
                                </Border>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="72" HeightRequest="86" BackgroundColor="{StaticResource HeaderOverlay}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 22" VerticalOptions="Center" Rotation="8">
                                <Label Text="🧺" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center" Rotation="-8" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--  Active order  -->
                    <VerticalStackLayout Padding="20,0" Spacing="12" IsVisible="{Binding HasActiveOrder}">
                        <Label Text="Your order, in motion" Style="{StaticResource H3}" />
                        <controls:OrderCardView BindingContext="{Binding ActiveOrder}" />
                    </VerticalStackLayout>

                    <!--  Categories  -->
                    <VerticalStackLayout Padding="20,0" Spacing="12">
                        <Label Text="Care for every garment" Style="{StaticResource H3}" />
                        <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:CategoryCardItem">
                                    <Border Style="{StaticResource Card}" FlexLayout.Basis="48%" Margin="0,0,0,12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="10">
                                            <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                                                <Label Text="{Binding Icon}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontSize="15" />
                                            <Label Text="{Binding Description}" Style="{StaticResource Small}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!--  Popular services  -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Popular right now" Style="{StaticResource H3}" Padding="20,0" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="12" Padding="20,0" BindableLayout.ItemsSource="{Binding PopularItems}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="items:PopularItemCard">
                                        <Border Style="{StaticResource Card}" WidthRequest="170">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="7">
                                                <Border StrokeThickness="0" BackgroundColor="{StaticResource SurfaceSubtle}" StrokeShape="RoundRectangle 14" Padding="16" Margin="0,0,0,3">
                                                    <Label Text="{Binding Icon}" FontSize="32" HorizontalOptions="Center" />
                                                </Border>
                                                <Label Text="{Binding Title}" Style="{StaticResource BodyMedium}" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Subtitle}" Style="{StaticResource Small}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Price, Converter={StaticResource Currency}}" TextColor="{StaticResource PrimaryDark}"
                                                       FontFamily="AppSemibold" FontSize="15" Margin="0,4,0,0" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!--  Recent orders  -->
                    <VerticalStackLayout Padding="20,0" Spacing="12" IsVisible="{Binding HasRecentOrders}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Recent orders" Style="{StaticResource H3}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="View all" Style="{StaticResource TextButton}" Command="{Binding ViewAllOrdersCommand}" />
                        </Grid>
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding RecentOrders}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:OrderCardItem">
                                    <controls:OrderCardView />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <!--  Cart bar  -->
        <Border Grid.Row="1" IsVisible="{Binding HasCart}" BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                StrokeShape="RoundRectangle 18" Margin="20,8,20,16" Padding="18,16">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding CartSummaryText, StringFormat='🧺  {0}'}" TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="14" />
                <Label Grid.Column="1" Text="View cart ›" TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="14" />
            </Grid>
        </Border>
    </Grid>
</views:BasePage>
