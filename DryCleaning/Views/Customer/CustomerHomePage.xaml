<?xml version="1.0" encoding="utf-8" ?>
<!--  C05 – Customer Home  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Customer"
                x:Class="DryCleaning.Views.Customer.CustomerHomePage"
                x:DataType="vm:CustomerHomeViewModel"
                Title="E Dry Cleaners">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Alerts" Command="{Binding OpenNotificationsCommand}" >
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FA" Glyph="&#xf0f3;" Size="20" Color="{StaticResource White}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <RefreshView IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="18" Padding="0,0,0,96">

                    <!--  Header  -->
                    <Border Background="{DynamicResource PrimaryGradientBrush}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 0,0,24,24" Padding="20,4,20,22">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Greeting}" TextColor="{DynamicResource PrimaryLight}"
                                   FontFamily="AppSemibold" FontSize="15" />
                            <Label Text="{Binding FirstName}" Style="{StaticResource HeaderTitle}" FontSize="27"
                                   LineBreakMode="TailTruncation" />
                            <Border BackgroundColor="{StaticResource HeaderOverlay}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12" Padding="12,8" Margin="0,10,0,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeAddressCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Label Text="&#xf3c5;" FontSize="14" VerticalOptions="Center"  FontFamily="FA" WidthRequest="24" HorizontalTextAlignment="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="Pickup address" TextColor="{DynamicResource PrimaryLight}" FontSize="11" />
                                        <Label Text="{Binding AddressText}" TextColor="{StaticResource White}" FontSize="13"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="Change" TextColor="{StaticResource White}" FontSize="12"
                                           FontFamily="AppSemibold" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Quick order  -->
                    <Border Margin="16,0" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="18"
                            Background="{DynamicResource PrimaryGradientBrush}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding QuickOrderCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Schedule a pickup" TextColor="{StaticResource White}" FontSize="18" FontFamily="AppSemibold" />
                                <Label Text="We collect, clean and deliver back to your door." TextColor="{DynamicResource PrimaryLight}" FontSize="13" />
                                <Border BackgroundColor="{StaticResource White}" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        Padding="14,6" HorizontalOptions="Start" Margin="0,8,0,0">
                                    <Label Text="Start an order ›" TextColor="{DynamicResource Primary}" FontSize="13" FontFamily="AppSemibold" />
                                </Border>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="&#xf291;" FontSize="44" VerticalOptions="Center"  FontFamily="FA" WidthRequest="62" HorizontalTextAlignment="Center" TextColor="{StaticResource White}"/>
                        </Grid>
                    </Border>

                    <!--  Active order  -->
                    <VerticalStackLayout Padding="16,0" Spacing="10" IsVisible="{Binding HasActiveOrder}">
                        <Label Text="Active order" Style="{StaticResource H3}" />
                        <controls:OrderCardView BindingContext="{Binding ActiveOrder}" />
                    </VerticalStackLayout>

                    <!--  Categories  -->
                    <VerticalStackLayout Padding="16,0" Spacing="10">
                        <Label Text="Services" Style="{StaticResource H3}" />
                            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween"
                                        BindableLayout.ItemsSource="{Binding Categories}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="items:CategoryCardItem">
                                        <Border Style="{StaticResource Card}" FlexLayout.Basis="48%" Margin="0,0,0,12">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="8">
                                                <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                                                    <Label Text="{Binding Icon}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{StaticResource InfoDark}" />
                                                </Border>
                                                <Label Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontSize="15" />
                                                <Label Text="{Binding Description}" Style="{StaticResource Small}" MaxLines="2" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                    </VerticalStackLayout>

                    <!--  Popular services  -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Popular right now" Style="{StaticResource H3}" Padding="16,0" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="12" Padding="16,0" BindableLayout.ItemsSource="{Binding PopularItems}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="items:PopularItemCard">
                                        <Border Style="{StaticResource Card}" WidthRequest="170">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Icon}" FontSize="28"  FontFamily="FA" VerticalOptions="Center" TextColor="{DynamicResource Primary}" />
                                                <Label Text="{Binding Title}" Style="{StaticResource BodyMedium}" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Subtitle}" Style="{StaticResource Small}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Price, Converter={StaticResource Currency}}" TextColor="{DynamicResource Primary}"
                                                       FontFamily="AppSemibold" FontSize="15" Margin="0,4,0,0" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!--  Recent orders  -->
                    <VerticalStackLayout Padding="16,0" Spacing="10" IsVisible="{Binding HasRecentOrders}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Recent orders" Style="{StaticResource H3}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="View all" Style="{StaticResource TextButton}" Command="{Binding ViewAllOrdersCommand}" />
                        </Grid>
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding RecentOrders}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:OrderCardItem">
                                    <controls:OrderCardView />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <!--  Cart bar  -->
        <Border Grid.Row="1" IsVisible="{Binding HasCart}" Background="{DynamicResource PrimaryGradientBrush}" StrokeThickness="0"
                StrokeShape="RoundRectangle 14" Margin="16,8,16,16" Padding="16,14">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto">
                <Label TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="14" ><Label.FormattedText><FormattedString><Span Text="&#xf291;" FontFamily="FA" /><Span Text="{Binding CartSummaryText, StringFormat='  {0}'}" /></FormattedString></Label.FormattedText></Label>
                <Label Grid.Column="1" Text="View cart ›" TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="14" />
            </Grid>
        </Border>
    </Grid>
</views:BasePage>
