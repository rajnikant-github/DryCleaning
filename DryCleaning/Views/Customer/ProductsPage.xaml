<?xml version="1.0" encoding="utf-8" ?>
<!--  C07 – Products  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:services="clr-namespace:DryCleaning.Services"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Customer"
                x:Class="DryCleaning.Views.Customer.ProductsPage"
                x:DataType="vm:ProductsViewModel"
                Title="{Binding CategoryName}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:AvatarView Text="{Binding ProviderInitials}" AvatarSize="48" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding ProviderName}" Style="{StaticResource BodyMedium}" FontSize="16" />
                            <Label Text="{Binding ProviderInfo}" Style="{StaticResource Small}" MaxLines="2" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Label Text="Select an item" Style="{StaticResource SectionLabel}" Margin="0,4,0,0" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Products}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="items:ProductRow">
                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource Muted}">
                                        <Label Text="{Binding Icon}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource BodyMedium}" />
                                        <Label Text="{Binding Description}" Style="{StaticResource Small}" MaxLines="1" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding OptionsText}" Style="{StaticResource Small}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding StartingPriceText}" TextColor="{StaticResource PrimaryDark}" FontFamily="AppSemibold" FontSize="14" HorizontalOptions="End" />
                                        <Label Text="›" FontSize="22" TextColor="{StaticResource MutedForeground}" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" EmptyIcon="🧺" EmptyTitle="No items" EmptyMessage="This provider has no items in this category yet." />

        <!--  Cart bar  -->
        <Border Grid.Row="1" IsVisible="{Binding HasCart}" BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                StrokeShape="RoundRectangle 18" Margin="20,8,20,16" Padding="18,16">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding CartSummaryText, StringFormat='🧺  {0}'}" TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="14" />
                <Label Grid.Column="1" Text="View cart ›" TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="14" />
            </Grid>
        </Border>
    </Grid>
</views:BasePage>
