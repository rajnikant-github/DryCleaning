<?xml version="1.0" encoding="utf-8" ?>
<!--  C12 – Pickup date and time slot  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:services="clr-namespace:DryCleaning.Services"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Customer"
                x:Class="DryCleaning.Views.Customer.PickupTimePage"
                x:DataType="vm:PickupTimeViewModel"
                Title="Pickup Time">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:SegmentBar ItemsSource="{Binding Dates}" />

        <ScrollView Grid.Row="1" IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="{Binding SelectedDate, StringFormat='{0:dddd, d MMMM}'}" Style="{StaticResource H3}" />
                <Label Text="Choose a 2-hour window. A driver will collect your items during this time." Style="{StaticResource Caption}" />

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Slots}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="items:SlotItem">
                            <Border Style="{StaticResource Card}" StrokeThickness="2" Padding="16,14">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="BackgroundColor" Value="#F0F5FF" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsUnavailable}" Value="True">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Text="&#xf017;" FontSize="18" VerticalOptions="Center"  FontFamily="FA" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                    <Label Grid.Column="1" Text="{Binding Label}" Style="{StaticResource BodyMedium}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="Unavailable" Style="{StaticResource Small}" IsVisible="{Binding IsUnavailable}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="&#xf00c;" TextColor="{StaticResource Primary}" FontSize="18" FontFamily="FA"
                                           IsVisible="{Binding IsSelected}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource WarningSoft}" IsVisible="{Binding HasNoSlots}">
                    <Label Text="No more pickup windows today. Please choose another day." TextColor="{StaticResource WarningDark}" FontSize="13" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView Grid.Row="1" State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="2" IsVisible="{Binding IsContent}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeShape="Rectangle" Padding="16,12,16,20">
            <Button Text="{Binding ContinueText}" Command="{Binding ContinueCommand}" />
        </Border>
    </Grid>
</views:BasePage>
