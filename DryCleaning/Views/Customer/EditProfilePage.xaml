<?xml version="1.0" encoding="utf-8" ?>
<!--  Edit profile (added screen)  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:services="clr-namespace:DryCleaning.Services"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Customer"
                x:Class="DryCleaning.Views.Customer.EditProfilePage"
                x:DataType="vm:EditProfileViewModel"
                Title="Edit Profile">
    <Grid RowDefinitions="*,Auto">
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Full name" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry Text="{Binding Name}" Placeholder="Your name" MaxLength="100" Keyboard="Text" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry Text="{Binding Email}" Placeholder="you@example.com" Keyboard="Email" MaxLength="150" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mobile number" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry Text="{Binding Phone}" Placeholder="+27 82 123 4567" Keyboard="Telephone" MaxLength="20" />
                    </Border>
                </VerticalStackLayout>
                <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource ErrorSoft}" IsVisible="{Binding HasValidationMessage}">
                    <Label Text="{Binding ValidationMessage}" TextColor="{StaticResource ErrorDark}" FontSize="13" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="1" IsVisible="{Binding IsContent}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 24,24,0,0" Padding="20,16,20,22">
            <Grid>
                <Button Text="Save Changes" Command="{Binding SaveCommand}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource White}"
                                   HorizontalOptions="End" Margin="0,0,16,0" WidthRequest="20" HeightRequest="20" />
            </Grid>
        </Border>
    </Grid>
</views:BasePage>
