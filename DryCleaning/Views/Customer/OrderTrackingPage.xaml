<?xml version="1.0" encoding="utf-8" ?>
<!--  C16 – Order tracking  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:services="clr-namespace:DryCleaning.Services"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Customer"
                x:Class="DryCleaning.Views.Customer.OrderTrackingPage"
                x:DataType="vm:OrderTrackingViewModel"
                Title="Track Order">
    <Grid RowDefinitions="*,Auto">
        <RefreshView IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
                    <!--  Status  -->
                    <Border Style="{StaticResource HeroCard}">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding OrderNumber}" Style="{StaticResource HeroEyebrow}" VerticalOptions="Center" />
                                <controls:StatusChip Grid.Column="1" Status="{Binding Status}" />
                            </Grid>
                            <Label Text="Your garments are&#10;in good hands." Style="{StaticResource HeroTitle}" />
                            <Label Text="{Binding StatusMessage}" Style="{StaticResource HeroBody}" />
                            <Border BackgroundColor="{StaticResource HeaderOverlay}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                                    IsVisible="{Binding EstimatedCompletionText, Converter={StaticResource HasValue}}">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="ESTIMATED DELIVERY" Style="{StaticResource HeroEyebrow}" FontSize="10" />
                                    <Label Text="{Binding EstimatedCompletionText, StringFormat='Estimated delivery: {0}'}" TextColor="{StaticResource White}" FontSize="14" FontFamily="AppSemibold" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource WarningSoft}" IsVisible="{Binding NeedsPayment}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="Payment pending – complete it to send your order to the provider." TextColor="{StaticResource WarningDark}" FontSize="13" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Pay now" Style="{StaticResource SmallPrimaryButton}" Command="{Binding PayNowCommand}" />
                        </Grid>
                    </Border>

                    <!--  Journey status from the order; does not imply live GPS tracking.  -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding ShowMap}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" BackgroundColor="{StaticResource PrimarySoft}" StrokeShape="RoundRectangle 17" VerticalOptions="Center">
                                <Label Text="🚗" FontSize="25" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                <Label Text="ON THE MOVE" Style="{StaticResource SectionLabel}" TextColor="{StaticResource PrimaryDark}" Margin="0" FontSize="10" />
                                <Label Text="{Binding MapCaption}" FontSize="15" FontFamily="AppSemibold" TextColor="{StaticResource AppForeground}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!--  Driver  -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasDriver}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <controls:AvatarView Text="{Binding DriverInitials}" AvatarSize="44" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="YOUR COURIER" Style="{StaticResource SectionLabel}" FontSize="10" Margin="0,0,0,3" />
                                <Label Text="{Binding DriverName}" Style="{StaticResource BodyMedium}" />
                                <Label Text="{Binding DriverInfo}" Style="{StaticResource Small}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource PrimarySoft}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CallDriverCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="📞" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                <!--  Verification codes  -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowPickupCode}" BackgroundColor="{StaticResource PrimarySoft}" Stroke="{StaticResource TransparentBrush}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Pickup code" Style="{StaticResource SectionLabel}" TextColor="{StaticResource MutedForeground}" />
                        <Label Text="{Binding PickupCode}" FontSize="30" FontFamily="AppSemibold" CharacterSpacing="6" TextColor="{StaticResource PrimaryDark}" />
                        <Label Text="Show this code to the driver when they collect your items." Style="{StaticResource Small}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowDeliveryOtp}" BackgroundColor="{StaticResource SuccessSoft}" Stroke="{StaticResource TransparentBrush}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Delivery OTP" Style="{StaticResource SectionLabel}" TextColor="{StaticResource SuccessDark}" />
                        <Label Text="{Binding DeliveryOtp}" FontSize="30" FontFamily="AppSemibold" CharacterSpacing="6" TextColor="{StaticResource SuccessDark}" />
                        <Label Text="Only share this with the driver once you have received your order." Style="{StaticResource Small}" />
                    </VerticalStackLayout>
                </Border>

                    <!--  Provider  -->
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                                <Label Text="🏪" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding ProviderName}" Style="{StaticResource BodyMedium}" />
                                <Label Text="{Binding PickupText, StringFormat='Pickup: {0}'}" Style="{StaticResource Small}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource Muted}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CallProviderCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="📞" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="Order progress" Style="{StaticResource H3}" Margin="0,0,0,18" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Timeline}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:TimelineStep">
                                    <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                        <Grid RowDefinitions="28,*">
                                            <Border WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="2"
                                                    Stroke="{StaticResource BorderBrush}" BackgroundColor="{StaticResource White}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsAlert}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Error}" />
                                                        <Setter Property="Stroke" Value="{StaticResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Marker}" TextColor="{StaticResource White}" FontSize="11" FontFamily="AppSemibold"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <BoxView Grid.Row="1" WidthRequest="2" HorizontalOptions="Center" MinimumHeightRequest="18"
                                                     Color="{StaticResource BorderColor}" IsVisible="{Binding ShowLine}">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Color" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>
                                        </Grid>
                                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" Padding="10,7" Margin="0,0,0,12">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAlert}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource ErrorSoft}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Title}" FontSize="14" TextColor="{StaticResource MutedForeground}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource AppForeground}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="FontFamily" Value="AppSemibold" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsAlert}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource ErrorDark}" />
                                                        <Setter Property="FontFamily" Value="AppSemibold" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding TimeText}" Style="{StaticResource Small}" IsVisible="{Binding HasTime}" />
                                            <Label Text="{Binding Notes}" Style="{StaticResource Small}" TextColor="{StaticResource MutedForeground}" IsVisible="{Binding HasNotes}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="1" IsVisible="{Binding IsContent}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 24,24,0,0" Padding="20,16,20,22">
            <Button Text="View Order Details" Command="{Binding ViewDetailsCommand}" Style="{StaticResource OutlineButton}" />
        </Border>
    </Grid>
</views:BasePage>
