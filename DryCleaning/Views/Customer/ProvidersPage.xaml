<?xml version="1.0" encoding="utf-8" ?>
<!--  Providers for a category (added screen)  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:services="clr-namespace:DryCleaning.Services"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Customer"
                x:Class="DryCleaning.Views.Customer.ProvidersPage"
                x:DataType="vm:ProvidersViewModel"
                Title="{Binding CategoryName}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="Choose a provider" Style="{StaticResource H2}" />
                <Label Text="Each order is handled by one provider. Prices and turnaround differ per provider." Style="{StaticResource Caption}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Providers}" Margin="0,6,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="items:ProviderCardItem">
                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <controls:AvatarView Text="{Binding Initials}" AvatarSize="48" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontSize="16" />
                                            <Label Style="{StaticResource Small}" ><Label.FormattedText><FormattedString><Span Text="&#xf3c5;" FontFamily="FA" /><Span Text="{Binding LocalityText, StringFormat='  {0}'}" /></FormattedString></Label.FormattedText></Label>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource MutedForeground}" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Text="{Binding Description}" Style="{StaticResource Caption}" MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{StaticResource Small}" TextColor="{StaticResource InfoDark}" VerticalOptions="Center" ><Label.FormattedText><FormattedString><Span Text="&#xf2f2;" FontFamily="FA" /><Span Text="{Binding TurnaroundText, StringFormat='  {0}'}" /></FormattedString></Label.FormattedText></Label>
                                        <Label Grid.Column="1" Text="{Binding StartingPriceText}" TextColor="{StaticResource Primary}" FontFamily="AppSemibold" FontSize="14" />
                                    </Grid>
                                    <Label Text="{Binding CategoriesText}" Style="{StaticResource Small}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" EmptyIcon="&#xf54e;" EmptyTitle="No providers yet" EmptyMessage="No provider offers this service in your area yet." />

        <!--  Cart bar  -->
        <Border Grid.Row="1" IsVisible="{Binding HasCart}" BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                StrokeShape="RoundRectangle 14" Margin="16,8,16,16" Padding="16,14">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto">
                <Label TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="14" ><Label.FormattedText><FormattedString><Span Text="&#xf291;" FontFamily="FA" /><Span Text="{Binding CartSummaryText, StringFormat='  {0}'}" /></FormattedString></Label.FormattedText></Label>
                <Label Grid.Column="1" Text="View cart ›" TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="14" />
            </Grid>
        </Border>
    </Grid>
</views:BasePage>
