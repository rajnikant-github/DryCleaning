<?xml version="1.0" encoding="utf-8" ?>
<!--  C11 – Pickup address (Google Places)  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:services="clr-namespace:DryCleaning.Services"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Customer"
                x:Class="DryCleaning.Views.Customer.PickupAddressPage"
                x:DataType="vm:PickupAddressViewModel"
                Title="{Binding PageTitle}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="{Binding HeadlineText}" Style="{StaticResource H2}" />

                <!--  Autocomplete search  -->
                <Border Style="{StaticResource InputField}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="&#xf002;" VerticalOptions="Center"  FontFamily="FA" WidthRequest="24" HorizontalTextAlignment="Center"/>
                        <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Search street, suburb or building" ClearButtonVisibility="WhileEditing" />
                        <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsSearching}" IsVisible="{Binding IsSearching}" WidthRequest="20" HeightRequest="20" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasPredictions}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Predictions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="items:PredictionItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="&#xf3c5;" VerticalOptions="Center"  FontFamily="FA" WidthRequest="24" HorizontalTextAlignment="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="{Binding MainText}" Style="{StaticResource BodyMedium}" FontSize="14" />
                                        <Label Text="{Binding SecondaryText}" Style="{StaticResource Small}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Label Text="No matching addresses. Try a street name or suburb." Style="{StaticResource Small}" IsVisible="{Binding ShowNoResults}" />
                <Label Text="{Binding SearchError}" Style="{StaticResource Small}" TextColor="{StaticResource ErrorDark}" IsVisible="{Binding HasSearchError}" />

                <Button Text="Use my current location" ContentLayout="Left,8" Style="{StaticResource SecondaryButton}" Command="{Binding UseCurrentLocationCommand}" >
                    <Button.ImageSource><FontImageSource FontFamily="FA" Glyph="&#xf3c5;" Size="16" Color="{DynamicResource Primary}" /></Button.ImageSource>
                </Button>

                <!--  Map placeholder  -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="150" BackgroundColor="#E0F2FE" IsVisible="{Binding HasSelection}">
                    <Grid>
                        <Label Text="&#xf279;" FontSize="56" Opacity="0.35" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{DynamicResource Primary}"/>
                        <Label Text="&#xf3c5;" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{DynamicResource Primary}"/>
                        <Label Text="Map preview appears once a Google Maps key is configured" Style="{StaticResource Small}"
                               HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,8" />
                    </Grid>
                </Border>

                <!--  Selected address  -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasSelection}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Selected address" Style="{StaticResource SectionLabel}" />
                        <Label Text="{Binding FormattedAddress}" Style="{StaticResource BodyMedium}" />
                        <Label Text="Unit / complex / building (optional)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Text="{Binding AddressLine2}" Placeholder="e.g. Unit 12, Sea Point Towers" MaxLength="200" />
                        </Border>
                        <Button Text="Show address details" Style="{StaticResource TextButton}" Command="{Binding ToggleDetailsCommand}" HorizontalOptions="Start">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ShowDetails}" Value="True">
                                    <Setter Property="Text" Value="Hide address details" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowDetails}" BindableLayout.ItemsSource="{Binding AddressFields}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:KeyValueRow">
                                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                                        <Label Text="{Binding Label}" Style="{StaticResource Small}" />
                                        <Label Grid.Column="1" Text="{Binding Value}" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="1" IsVisible="{Binding IsContent}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeShape="Rectangle" Padding="16,12,16,20">
            <Grid>
                <Button Text="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource White}"
                                   HorizontalOptions="End" Margin="0,0,16,0" WidthRequest="20" HeightRequest="20" />
            </Grid>
        </Border>
    </Grid>
</views:BasePage>
