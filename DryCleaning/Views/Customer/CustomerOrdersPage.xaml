<?xml version="1.0" encoding="utf-8" ?>
<!--  C17 – My orders  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:icons="clr-namespace:DryCleaning.Helpers"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:services="clr-namespace:DryCleaning.Services"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Customer"
                x:Class="DryCleaning.Views.Customer.CustomerOrdersPage"
                x:DataType="vm:CustomerOrdersViewModel"
                Title="My Orders">
    <Grid RowDefinitions="Auto,*">
        <controls:SegmentBar ItemsSource="{Binding Segments}" />

        <RefreshView Grid.Row="1" IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Orders}" SelectionMode="None">
                <CollectionView.Header>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="items:OrderCardItem">
                        <controls:OrderCardView Padding="16,0,16,12" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <controls:PageStateView Grid.Row="1"
                                State="{Binding State}"
                                RetryCommand="{Binding RetryCommand}"
                                ErrorMessage="{Binding ErrorMessage}"
                                EmptyIcon="{x:Static icons:AppIcons.Box}"
                                EmptyTitle="{Binding EmptyText}"
                                EmptyMessage="Schedule a pickup and your orders will show up here." />

        <Button Grid.Row="1" Text="+ New Order" Command="{Binding NewOrderCommand}" IsVisible="{Binding IsEmpty}"
                VerticalOptions="End" Margin="16,0,16,24" />
    </Grid>
</views:BasePage>
