<?xml version="1.0" encoding="utf-8" ?>
<!--  C18 – Order detail  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:services="clr-namespace:DryCleaning.Services"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Customer"
                x:Class="DryCleaning.Views.Customer.CustomerOrderDetailPage"
                x:DataType="vm:CustomerOrderDetailViewModel"
                Title="{Binding OrderNumber}">
    <Grid RowDefinitions="*,Auto">
        <RefreshView IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
                    <!--  Summary  -->
                    <Border Style="{StaticResource HeroCard}">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding OrderNumber}" Style="{StaticResource HeroEyebrow}" VerticalOptions="Center" />
                                <controls:StatusChip Grid.Column="1" Status="{Binding Status}" HorizontalOptions="End" />
                            </Grid>
                            <Label Text="Every detail,&#10;taken care of." Style="{StaticResource HeroTitle}" />
                            <Label Text="{Binding StatusMessage}" Style="{StaticResource HeroBody}" />
                            <BoxView HeightRequest="1" Color="{StaticResource HeaderOverlay}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding CreatedText}" Style="{StaticResource HeroBody}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Total, Converter={StaticResource Currency}}"
                                       TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="22" HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Dispute  -->
                    <Border Style="{StaticResource SoftPanel}" BackgroundColor="#FFF7ED" IsVisible="{Binding HasDispute}" Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding DisputeTitle, StringFormat='⚠  {0}'}" TextColor="#C2410C" FontFamily="AppSemibold" FontSize="14" />
                            <Label Text="{Binding DisputeText}" TextColor="#9A3412" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                <!--  Verification codes  -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowPickupCode}" BackgroundColor="{StaticResource PrimarySoft}" Stroke="{StaticResource TransparentBrush}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Pickup code" Style="{StaticResource SectionLabel}" TextColor="{StaticResource MutedForeground}" />
                        <Label Text="{Binding PickupCode}" FontSize="30" FontFamily="AppSemibold" CharacterSpacing="6" TextColor="{StaticResource PrimaryDark}" />
                        <Label Text="Show this code to the driver when they collect your items." Style="{StaticResource Small}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowDeliveryOtp}" BackgroundColor="{StaticResource SuccessSoft}" Stroke="{StaticResource TransparentBrush}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Delivery OTP" Style="{StaticResource SectionLabel}" TextColor="{StaticResource SuccessDark}" />
                        <Label Text="{Binding DeliveryOtp}" FontSize="30" FontFamily="AppSemibold" CharacterSpacing="6" TextColor="{StaticResource SuccessDark}" />
                        <Label Text="Only share this with the driver once you have received your order." Style="{StaticResource Small}" />
                    </VerticalStackLayout>
                </Border>

                    <!--  Provider & pickup  -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Text="🏪" FontSize="18" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Provider" Style="{StaticResource Small}" />
                                    <Label Text="{Binding ProviderName}" Style="{StaticResource BodyMedium}" FontSize="14" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource Muted}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CallProviderCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="📞" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                            <BoxView Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="📍" FontSize="18" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Pickup &amp; delivery address" Style="{StaticResource Small}" />
                                    <Label Text="{Binding AddressText}" FontSize="14" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="🕘" FontSize="18" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Pickup time" Style="{StaticResource Small}" />
                                    <Label Text="{Binding PickupText}" FontSize="14" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Items  -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Itemized package" Style="{StaticResource H3}" Margin="0,0,0,16" />
                                <Label Grid.Column="1" Text="{Binding ItemCountText}" Style="{StaticResource Small}" />
                            </Grid>
                            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:OrderItemDetail">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Label Text="{Binding Icon}" FontSize="24" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" Style="{StaticResource BodyMedium}" FontSize="14" />
                                                <Label Text="{Binding Subtitle}" Style="{StaticResource Small}" />
                                                <Label Text="{Binding Notes, StringFormat='📝 {0}'}" Style="{StaticResource Small}" IsVisible="{Binding HasNotes}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding TotalPrice, Converter={StaticResource Currency}}"
                                                   Style="{StaticResource BodyMedium}" FontSize="14" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <BoxView Style="{StaticResource Divider}" Margin="0,14,0,10" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                <Label Text="Subtotal" Style="{StaticResource Caption}" />
                                <Label Grid.Column="1" Text="{Binding SubTotal, Converter={StaticResource Currency}}" FontSize="14" />
                                <Label Grid.Row="1" Text="Pickup &amp; delivery" Style="{StaticResource Caption}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DeliveryFee, Converter={StaticResource Currency}}" FontSize="14" />
                                <Label Grid.Row="2" Text="{Binding VatLabel}" Style="{StaticResource Caption}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Tax, Converter={StaticResource Currency}}" FontSize="14" />
                                <Label Grid.Row="3" Text="Total" Style="{StaticResource BodyMedium}" Margin="0,4,0,0" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding Total, Converter={StaticResource Currency}}"
                                       Style="{StaticResource BodyMedium}" TextColor="{StaticResource PrimaryDark}" Margin="0,4,0,0" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Payment  -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Payment" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding PaymentText}" FontSize="14" />
                        </VerticalStackLayout>
                    </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="Order progress" Style="{StaticResource H3}" Margin="0,0,0,18" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Timeline}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:TimelineStep">
                                    <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                        <Grid RowDefinitions="28,*">
                                            <Border WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="2"
                                                    Stroke="{StaticResource BorderBrush}" BackgroundColor="{StaticResource White}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsAlert}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Error}" />
                                                        <Setter Property="Stroke" Value="{StaticResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Marker}" TextColor="{StaticResource White}" FontSize="11" FontFamily="AppSemibold"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <BoxView Grid.Row="1" WidthRequest="2" HorizontalOptions="Center" MinimumHeightRequest="18"
                                                     Color="{StaticResource BorderColor}" IsVisible="{Binding ShowLine}">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Color" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>
                                        </Grid>
                                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" Padding="10,7" Margin="0,0,0,12">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAlert}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource ErrorSoft}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Title}" FontSize="14" TextColor="{StaticResource MutedForeground}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource AppForeground}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="FontFamily" Value="AppSemibold" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsAlert}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource ErrorDark}" />
                                                        <Setter Property="FontFamily" Value="AppSemibold" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding TimeText}" Style="{StaticResource Small}" IsVisible="{Binding HasTime}" />
                                            <Label Text="{Binding Notes}" Style="{StaticResource Small}" TextColor="{StaticResource MutedForeground}" IsVisible="{Binding HasNotes}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="1" IsVisible="{Binding HasFooter}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 24,24,0,0" Padding="20,16,20,22">
            <VerticalStackLayout Spacing="10">
                <Button Text="Pay Now" Command="{Binding PayNowCommand}" IsVisible="{Binding CanPay}" />
                <Button Text="Track Order" Command="{Binding TrackCommand}" IsVisible="{Binding IsActive}" Style="{StaticResource SecondaryButton}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Cancel Order" Command="{Binding CancelOrderCommand}" IsVisible="{Binding CanCancel}"
                            Style="{StaticResource OutlineButton}" TextColor="{StaticResource ErrorDark}" />
                    <Button Grid.Column="1" Text="Report a Problem" Command="{Binding RaiseDisputeCommand}" IsVisible="{Binding CanRaiseDispute}"
                            Style="{StaticResource OutlineButton}" TextColor="{StaticResource MutedForeground}" />
                </Grid>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:BasePage>
