<?xml version="1.0" encoding="utf-8" ?>
<!--  Upload one verification document  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels"
                x:Class="DryCleaning.Views.DocumentPage"
                x:DataType="vm:DocumentViewModel"
                Title="Document">
    <Grid RowDefinitions="*,Auto">
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="16,20" Spacing="14">
                <Label Text="{Binding Title}" Style="{StaticResource H2}" />
                <Label Text="{Binding Description}" Style="{StaticResource Caption}" IsVisible="{Binding HasDescription}" />

                <Border BackgroundColor="#FEF2F2" Stroke="#FECACA" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12"
                        IsVisible="{Binding HasRejection}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Our team rejected this document" FontFamily="AppSemibold" FontSize="14" TextColor="#B91C1C" />
                        <Label Text="{Binding RejectionMessage}" FontSize="13" TextColor="#B91C1C" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#F3F4F6" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12" IsVisible="{Binding HasNote}">
                    <Label Text="{Binding Note}" FontSize="13" TextColor="#4B5563" />
                </Border>

                <Button Text="View uploaded file" Style="{StaticResource OutlineButton}" Command="{Binding ViewFileCommand}"
                        IsVisible="{Binding HasUploadedFile}" IsEnabled="{Binding IsNotBusy}" />

                <VerticalStackLayout Spacing="6" IsVisible="{Binding HasNumber}">
                    <Label Text="{Binding NumberLabel}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry Text="{Binding Number}" Placeholder="{Binding NumberLabel}" MaxLength="60" Keyboard="Text" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6" IsVisible="{Binding HasExpiry}">
                    <Label Text="Expiry date" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <DatePicker Date="{Binding ExpiresOn}" MinimumDate="{Binding MinExpiry}" Format="d MMMM yyyy" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding FileLabel}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding FileText}" VerticalOptions="Center" LineBreakMode="MiddleTruncation" Style="{StaticResource Caption}" />
                            <Button Grid.Column="1" Text="Choose" Style="{StaticResource SmallOutlineButton}" Command="{Binding ChooseFileCommand}" />
                        </Grid>
                    </Border>
                    <Label Text="Only our verification team can see your documents. We use them to confirm who you are." Style="{StaticResource Small}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="1" IsVisible="{Binding IsContent}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeShape="Rectangle" Padding="16,12,16,20">
            <Grid>
                <Button Text="Submit document" Command="{Binding SubmitCommand}" IsVisible="{Binding IsNotBusy}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="52" />
            </Grid>
        </Border>
    </Grid>
</views:BasePage>
