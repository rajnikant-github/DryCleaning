<?xml version="1.0" encoding="utf-8" ?>
<!--  Onboarding 1–3 (Figma: Customer General Onboarding)  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Onboarding"
                x:Class="DryCleaning.Views.Onboarding.OnboardingPage"
                x:DataType="vm:OnboardingViewModel"
                Shell.NavBarIsVisible="False"
                BackgroundColor="{StaticResource White}">
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Padding="{OnPlatform iOS='0,48,0,16', Default='0,28,0,16'}">
        <!--  Logo, with the back arrow at the left  -->
        <Grid Grid.Row="0" Margin="24,0">
            <Image Source="applogo.png" WidthRequest="240" HeightRequest="120" Aspect="AspectFit"
                   HorizontalOptions="Center" SemanticProperties.Description="E Dry Cleaners" />
            <Button Text="&#xf053;" FontFamily="FA" FontSize="20" TextColor="{DynamicResource Primary}"
                    BackgroundColor="Transparent" Padding="0" WidthRequest="44" HeightRequest="44"
                    HorizontalOptions="Start" VerticalOptions="Start" Margin="-8,36,0,0"
                    Command="{Binding BackCommand}" SemanticProperties.Description="Back" />
        </Grid>

        <!--  Slides  -->
        <CarouselView Grid.Row="1" ItemsSource="{Binding Slides}" Position="{Binding Position, Mode=TwoWay}"
                      Loop="False" IsBounceEnabled="False" PeekAreaInsets="0" Margin="0,8"
                      HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="items:OnboardingSlide">
                    <Grid RowDefinitions="*,Auto" RowSpacing="16" Padding="32,0">
                        <Image Source="{Binding Image}" Aspect="AspectFit" MaximumHeightRequest="280" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center">
                            <Label Text="{Binding Title}" Style="{StaticResource OnboardingTitle}" />
                            <Label Text="{Binding Description}" Style="{StaticResource OnboardingBody}" MaximumWidthRequest="272" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!--  Page dots  -->
        <IndicatorView Grid.Row="2" Count="3" Position="{Binding Position}" IndicatorSize="10" IndicatorsShape="Circle"
                       IndicatorColor="{StaticResource OnboardingMuted}" SelectedIndicatorColor="{DynamicResource Primary}"
                       HorizontalOptions="Center" Margin="0,8,0,16" />

        <!--  Next / Get Started  -->
        <Button Grid.Row="3" Text="{Binding ButtonText}" Command="{Binding NextCommand}" Style="{StaticResource OnboardingPill}"
                HorizontalOptions="Center">
        </Button>

        <!--  Skip (hidden on the last slide, keeping its space so nothing jumps)  -->
        <Button Grid.Row="4" Text="Skip" Command="{Binding SkipCommand}" Style="{StaticResource OnboardingLink}"
                HorizontalOptions="Center" Margin="0,8,0,0">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsLast}" Value="True">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="InputTransparent" Value="True" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </Grid>
</views:BasePage>
