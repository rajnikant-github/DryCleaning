<?xml version="1.0" encoding="utf-8" ?>
<!--  Verification documents list  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels"
                x:Class="DryCleaning.Views.DocumentsPage"
                x:DataType="vm:DocumentsViewModel"
                Title="Documents">
    <Grid>
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="14" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="items:DocumentRowItem">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="16,12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontSize="15" />
                                            <Label Text="{Binding Detail}" FontSize="12" TextColor="{Binding DetailColor}" IsVisible="{Binding HasDetail}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,4" VerticalOptions="Center"
                                                BackgroundColor="{Binding StatusBackground}">
                                            <Label Text="{Binding StatusText}" FontSize="12" FontFamily="AppSemibold" TextColor="{Binding StatusTextColor}" />
                                        </Border>
                                    </Grid>
                                    <BoxView Style="{StaticResource Divider}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}"
                                EmptyIcon="&#xf15c;" EmptyTitle="No documents needed" EmptyMessage="Our team hasn't asked for any documents yet." />
    </Grid>
</views:BasePage>
