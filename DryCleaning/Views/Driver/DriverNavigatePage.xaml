<?xml version="1.0" encoding="utf-8" ?>
<!--  D04 / D10 – Navigate to customer or provider  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Driver"
                x:Class="DryCleaning.Views.Driver.DriverNavigatePage"
                x:DataType="vm:DriverNavigateViewModel"
                Title="{Binding Title}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="20,12,20,28" Spacing="16">
                <Border Style="{StaticResource HeroCard}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="ON THE ROAD" Style="{StaticResource HeroEyebrow}" VerticalOptions="Center" />
                            <Image Grid.Column="1" Source="logo_mark_white.png" HeightRequest="28" WidthRequest="28" />
                        </Grid>
                        <Label Text="{Binding HeadingText}" Style="{StaticResource HeroTitle}" />
                        <BoxView Color="#70FFFFFF" HeightRequest="1" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="{StaticResource HeaderOverlay}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                <Label Text="↗" FontSize="24" TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding DestinationName}" FontFamily="AppSemibold" TextColor="{StaticResource White}" />
                                <Label Text="Turn-by-turn directions in your maps app" Style="{StaticResource HeroBody}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="DISTANCE" Style="{StaticResource SectionLabel}" Margin="0" FontSize="10" />
                            <Label Text="{Binding DistanceText}" Style="{StaticResource StatValue}" FontSize="22" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ESTIMATED TIME" Style="{StaticResource SectionLabel}" Margin="0" FontSize="10" />
                            <Label Text="{Binding EtaText}" Style="{StaticResource StatValue}" FontSize="22" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding DestinationLabel}" Style="{StaticResource SectionLabel}" Margin="0" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" BackgroundColor="{StaticResource PrimarySoft}" StrokeShape="RoundRectangle 10">
                                <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource PrimaryBrush}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding DestinationName}" Style="{StaticResource BodyMedium}" />
                                <Label Text="{Binding DestinationAddress}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource PrimarySoft}" VerticalOptions="Start">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CallDestinationCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="📞" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Button Text="Open route in Maps  ↗" Command="{Binding OpenMapsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,2,0,0" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource PrimarySoft}" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="YOUR NEXT STEP" FontSize="10" FontFamily="AppSemibold" CharacterSpacing="1" TextColor="{StaticResource PrimaryDark}" />
                        <Label Text="{Binding StepHint}" TextColor="{StaticResource PrimaryDark}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding OrderNumber, StringFormat='Order {0}'}" Style="{StaticResource Small}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="1" IsVisible="{Binding IsContent}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 24,24,0,0" Padding="20,16,20,24">
            <Button Text="{Binding ArrivedText}" Command="{Binding ArrivedCommand}" Style="{StaticResource PrimaryButton}" />
        </Border>
    </Grid>
</views:BasePage>
