<?xml version="1.0" encoding="utf-8" ?>
<!--  D03 – Job details  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Driver"
                x:Class="DryCleaning.Views.Driver.DriverJobDetailPage"
                x:DataType="vm:DriverJobDetailViewModel"
                Title="{Binding Title}">
    <Grid RowDefinitions="*,Auto">
        <RefreshView IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="20,12,20,28" Spacing="16">
                    <!--  Summary  -->
                    <Border Style="{StaticResource HeroCard}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="JOB OVERVIEW" Style="{StaticResource HeroEyebrow}" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource HeaderOverlay}">
                                    <Label Text="{Binding TypeIcon}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding TypeText, StringFormat='{0} job'}" Style="{StaticResource HeaderTitle}" FontSize="21" />
                                    <Label Text="{Binding OrderNumber}" Style="{StaticResource HeroBody}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Earnings, Converter={StaticResource Currency}}" TextColor="{StaticResource White}"
                                           FontFamily="AppSemibold" FontSize="24" HorizontalOptions="End" />
                                    <Label Text="YOUR EARNINGS" Style="{StaticResource HeroBody}" FontSize="9" CharacterSpacing="0.6" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#70FFFFFF" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding StatusText}" TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="13" VerticalOptions="Center" />
                                <controls:StatusChip Grid.Column="1" Status="{Binding OrderStatus}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Next step  -->
                    <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource PrimarySoft}" Padding="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border WidthRequest="28" HeightRequest="28" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Start">
                                <Label Text="→" TextColor="{StaticResource White}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="{Binding StepTitle}" TextColor="{StaticResource PrimaryDark}" FontFamily="AppSemibold" FontSize="15" />
                                <Label Text="{Binding StepHint}" TextColor="{StaticResource PrimaryDark}" FontSize="13" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SoftPanel}" BackgroundColor="#FFF7ED" IsVisible="{Binding IsOnHold}" Padding="14">
                        <Label Text="⚠  This order is on hold while EDry Cleaners support reviews an issue. Please wait for support to contact you." TextColor="#C2410C" FontSize="13" />
                    </Border>

                    <!--  Route  -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Your route" Style="{StaticResource H3}" />
                                <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalOptions="Center">
                                    <Label Text="{Binding RouteDistanceText}" FontSize="11" FontFamily="AppSemibold" TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="14,*,Auto" RowDefinitions="Auto,16,Auto" ColumnSpacing="10">
                                <Ellipse Fill="{StaticResource PrimaryBrush}" WidthRequest="12" HeightRequest="12" VerticalOptions="Start" Margin="0,4,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding FromLabel}" Style="{StaticResource Small}" />
                                    <Label Text="{Binding FromName}" Style="{StaticResource BodyMedium}" FontSize="15" />
                                    <Label Text="{Binding FromAddress}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource SuccessSoft}" VerticalOptions="Start" IsVisible="{Binding ShowContacts}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CallFromCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="📞" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <BoxView Grid.Row="1" WidthRequest="2" Color="{StaticResource BorderColor}" HorizontalOptions="Center" />
                                <Ellipse Grid.Row="2" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" WidthRequest="12" HeightRequest="12" VerticalOptions="Start" Margin="0,4,0,0" />
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding ToLabel}" Style="{StaticResource Small}" />
                                    <Label Text="{Binding ToName}" Style="{StaticResource BodyMedium}" FontSize="15" />
                                    <Label Text="{Binding ToAddress}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource IconTile}" BackgroundColor="{StaticResource SuccessSoft}" VerticalOptions="Start" IsVisible="{Binding ShowContacts}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CallToCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="📞" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource PrimarySoft}" IsVisible="{Binding HasSlot}" Padding="12,8">
                                <Label Text="{Binding SlotText, StringFormat='🕘  Customer pickup window: {0}'}" TextColor="{StaticResource PrimaryDark}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Text="Item manifest" Style="{StaticResource H3}" />
                                <Label Grid.Column="1" Text="{Binding ItemCountText}" Style="{StaticResource Small}" VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:OrderItemDetail">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="12" BackgroundColor="{StaticResource SurfaceSubtle}">
                                            <Label Text="{Binding Icon}" FontSize="22" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" Style="{StaticResource BodyMedium}" FontSize="14" />
                                                <Label Text="{Binding Subtitle}" Style="{StaticResource Small}" />
                                                <Label Text="{Binding Notes, StringFormat='📝 {0}'}" Style="{StaticResource Small}" IsVisible="{Binding HasNotes}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="1" IsVisible="{Binding IsContent}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 24,24,0,0" Padding="20,16,20,24">
            <VerticalStackLayout Spacing="10">
                <Button Text="Accept Job" Command="{Binding AcceptCommand}" Style="{StaticResource PrimaryButton}" IsVisible="{Binding CanAccept}" />
                <Button Text="{Binding ContinueText}" Command="{Binding ContinueCommand}" IsVisible="{Binding CanContinue}" />
                <Button Text="Release Job" Command="{Binding ReleaseCommand}" Style="{StaticResource OutlineButton}"
                        TextColor="{StaticResource MutedForeground}" IsVisible="{Binding CanRelease}" />
                <Label Text="{Binding CompletedText, StringFormat='✅  {0}'}" TextColor="{StaticResource SuccessDark}" FontSize="14"
                       HorizontalTextAlignment="Center" IsVisible="{Binding IsDone}" />
                <Label Text="This job is no longer available." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" IsVisible="{Binding IsUnavailable}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:BasePage>
