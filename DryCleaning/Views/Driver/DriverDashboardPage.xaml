<?xml version="1.0" encoding="utf-8" ?>
<!--  D01 – Driver dashboard  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Driver"
                x:Class="DryCleaning.Views.Driver.DriverDashboardPage"
                x:DataType="vm:DriverDashboardViewModel"
                Title="Dashboard">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Alerts" IconImageSource="ic_bell.png" Command="{Binding OpenNotificationsCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <RefreshView IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="20" Padding="0,12,0,28">
                    <!--  Header with availability  -->
                    <Border Style="{StaticResource HeroCard}" Margin="20,0">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="DRIVER DASHBOARD" Style="{StaticResource HeroEyebrow}" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="logo_mark_white.png" HeightRequest="30" WidthRequest="30" />
                            </Grid>
                            <Label Text="{Binding Greeting}" Style="{StaticResource HeroBody}" Margin="0,10,0,0" />
                            <Label Text="{Binding DriverName}" Style="{StaticResource HeroTitle}" />
                            <Border BackgroundColor="{StaticResource HeaderOverlay}" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                    Padding="14,12" Margin="0,12,0,0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource SuccessBrush}" VerticalOptions="Center">
                                        <Ellipse.Triggers>
                                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsDriverOffline}" Value="True">
                                                <Setter Property="Fill" Value="#94A3B8" />
                                            </DataTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="{Binding OnlineText}" TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="15" />
                                        <Label Text="{Binding OnlineHint}" TextColor="#FFE9E7" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="2" IsToggled="{Binding IsOnline}" OnColor="{StaticResource Success}" ThumbColor="{StaticResource White}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Today  -->
                    <Grid Padding="20,0" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenEarningsCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="TODAY'S EARNINGS" Style="{StaticResource SectionLabel}" FontSize="10" Margin="0" />
                                <Label Text="{Binding EarningsToday, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" TextColor="{StaticResource PrimaryDark}" />
                                <Label Text="View earnings  ›" Style="{StaticResource Small}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="COMPLETED TODAY" Style="{StaticResource SectionLabel}" FontSize="10" Margin="0" />
                                <Label Text="{Binding CompletedToday}" Style="{StaticResource StatValue}" />
                                <Label Text="Jobs delivered with care" Style="{StaticResource Small}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!--  Active job  -->
                    <VerticalStackLayout Padding="20,0" Spacing="12" IsVisible="{Binding HasActiveJob}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Your active job" Style="{StaticResource H2}" VerticalOptions="Center" />
                            <Border Grid.Column="1" Style="{StaticResource Badge}">
                                <Label Text="IN PROGRESS" FontSize="10" FontFamily="AppSemibold" TextColor="{StaticResource PrimaryDark}" />
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenActiveJobCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="16">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource PrimarySoft}">
                                        <Label Text="{Binding ActiveTypeIcon}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding ActiveTitle}" Style="{StaticResource BodyMedium}" />
                                        <Label Text="{Binding ActiveStepText}" TextColor="{StaticResource PrimaryDark}" FontSize="13" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource SurfaceSubtle}" Padding="16">
                                    <Grid ColumnDefinitions="16,*" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="5" Margin="0,4,0,0">
                                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource PrimaryBrush}" />
                                            <BoxView WidthRequest="2" HeightRequest="28" Color="{StaticResource BorderColor}" HorizontalOptions="Center" />
                                            <Ellipse WidthRequest="10" HeightRequest="10" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                                            <Label Text="NEXT DESTINATION" Style="{StaticResource SectionLabel}" FontSize="10" Margin="0" />
                                            <Label Text="{Binding ActiveDestination}" Style="{StaticResource BodyMedium}" />
                                            <Label Text="{Binding ActiveDistanceText}" FontSize="12" FontFamily="AppSemibold" TextColor="{StaticResource PrimaryDark}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                                <Button Text="{Binding ActiveActionText}" Command="{Binding ContinueActiveJobCommand}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!--  Find jobs  -->
                    <Border Style="{StaticResource Card}" Margin="20,0" IsVisible="{Binding IsOnline}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FindJobsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource PrimarySoft}">
                                <Image Source="tab_jobs.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Available jobs" Style="{StaticResource BodyMedium}" />
                                <Label Text="{Binding AvailableText}" Style="{StaticResource Small}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource MutedForeground}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource Muted}" Margin="20,0" Padding="16" IsVisible="{Binding IsDriverOffline}">
                        <Label Text="You're offline. Switch on availability above to start receiving pickup and delivery jobs." Style="{StaticResource Caption}" />
                    </Border>

                    <!--  Today's jobs  -->
                    <VerticalStackLayout Padding="20,0" Spacing="12" IsVisible="{Binding HasTodaysJobs}">
                        <Label Text="Today's activity" Style="{StaticResource H2}" />
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding TodaysJobs}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:DriverJobCardItem">
                                    <controls:DriverJobCardView />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />
    </Grid>
</views:BasePage>
