<?xml version="1.0" encoding="utf-8" ?>
<!--  D01 – Driver dashboard  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Driver"
                x:Class="DryCleaning.Views.Driver.DriverDashboardPage"
                x:DataType="vm:DriverDashboardViewModel"
                Title="Dashboard">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Alerts" Command="{Binding OpenNotificationsCommand}" >
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FA" Glyph="&#xf0f3;" Size="20" Color="{StaticResource White}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
        <RefreshView IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="16" Padding="0,0,0,100">
                    <!--  Header with availability  -->
                    <Border Background="{DynamicResource PrimaryGradientBrush}" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,24,24" Padding="20,4,20,22">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Greeting}" TextColor="{DynamicResource PrimaryLight}"
                                   FontFamily="AppSemibold" FontSize="15" />
                            <Label Text="{Binding DriverName}" Style="{StaticResource HeaderTitle}" FontSize="27"
                                   LineBreakMode="TailTruncation" />
                            <Border BackgroundColor="{StaticResource HeaderOverlay}" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    Padding="14,10" Margin="0,10,0,0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource SuccessBrush}" VerticalOptions="Center">
                                        <Ellipse.Triggers>
                                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsDriverOffline}" Value="True">
                                                <Setter Property="Fill" Value="#94A3B8" />
                                            </DataTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="{Binding OnlineText}" TextColor="{StaticResource White}" FontFamily="AppSemibold" FontSize="15" />
                                        <Label Text="{Binding OnlineHint}" TextColor="{DynamicResource PrimaryLight}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="2" IsToggled="{Binding IsOnline}" OnColor="{StaticResource Success}" ThumbColor="{StaticResource White}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Today  -->
                    <Grid Padding="16,0" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenEarningsCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Border WidthRequest="30" HeightRequest="30" BackgroundColor="{StaticResource SuccessSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                                        <Label Text="&#xf81d;" FontFamily="FA" FontSize="14" TextColor="{StaticResource SuccessDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="Today's earnings" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding EarningsToday, Converter={StaticResource Currency}}" FontSize="25" FontFamily="AppSemibold" TextColor="{StaticResource SuccessDark}" />
                                <Label Text="Today" Style="{StaticResource Small}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Border WidthRequest="30" HeightRequest="30" BackgroundColor="{StaticResource InfoSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                                        <Label Text="&#xf058;" FontFamily="FA" FontSize="14" TextColor="{StaticResource InfoDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="Jobs done today" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding CompletedToday}" FontSize="25" FontFamily="AppSemibold" TextColor="{DynamicResource Primary}" />
                                <Label Text="Completed" Style="{StaticResource Small}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!--  Active job  -->
                    <VerticalStackLayout Padding="16,0" Spacing="10" IsVisible="{Binding HasActiveJob}">
                        <Label Text="Active job" Style="{StaticResource H3}" />
                        <Border Style="{StaticResource Card}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenActiveJobCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource AccentSoft}">
                                        <Label Text="{Binding ActiveTypeIcon}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{StaticResource InfoDark}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding ActiveTitle}" Style="{StaticResource BodyMedium}" />
                                        <Label Text="{Binding ActiveStepText}" TextColor="{StaticResource InfoDark}" FontSize="13" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="120" BackgroundColor="#E0F2FE">
                    <Grid>
                        <Label Text="&#xf279;" FontSize="72" Opacity="0.3" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{DynamicResource Primary}"/>
                        <Label Text="&#xf1b9;" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{DynamicResource Primary}"/>
                        <Border BackgroundColor="{StaticResource White}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,4"
                                HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,10">
                            <Label Text="{Binding ActiveDistanceText}" FontSize="12" FontFamily="AppSemibold" TextColor="{DynamicResource Primary}" />
                        </Border>
                    </Grid>
                </Border>
                                <Label FontSize="14" ><Label.FormattedText><FormattedString><Span Text="&#xf3c5;" FontFamily="FA" /><Span Text="{Binding ActiveDestination, StringFormat='  {0}'}" /></FormattedString></Label.FormattedText></Label>
                                <Button Text="{Binding ActiveActionText}" Command="{Binding ContinueActiveJobCommand}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!--  Find jobs  -->
                    <Border Style="{StaticResource Card}" Margin="16,0" IsVisible="{Binding IsOnline}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FindJobsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource SuccessSoft}">
                                <Label Text="&#xf46d;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{StaticResource SuccessDark}"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Available jobs" Style="{StaticResource BodyMedium}" />
                                <Label Text="{Binding AvailableText}" Style="{StaticResource Small}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource MutedForeground}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource Muted}" Margin="16,0" Padding="14" IsVisible="{Binding IsDriverOffline}">
                        <Label Text="You're offline. Switch on availability above to start receiving pickup and delivery jobs." Style="{StaticResource Caption}" />
                    </Border>

                    <!--  Today's jobs  -->
                    <VerticalStackLayout Padding="16,0" Spacing="10">
                        <Label Text="Today's jobs" Style="{StaticResource H3}" />
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding HasTodaysJobs}"
                                             BindableLayout.ItemsSource="{Binding TodaysJobs}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:DriverJobCardItem">
                                    <controls:DriverJobCardView />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoTodaysJobs}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource InfoSoft}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 13">
                                    <Label Text="&#xf0d1;" FontFamily="FA" FontSize="18" TextColor="{StaticResource InfoDark}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="No jobs yet today" Style="{StaticResource BodyMedium}" FontSize="14" />
                                    <Label Text="New pickup and delivery jobs will appear here." Style="{StaticResource Small}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />
    </Grid>
</views:BasePage>
