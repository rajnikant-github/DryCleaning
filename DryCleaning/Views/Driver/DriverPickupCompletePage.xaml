<?xml version="1.0" encoding="utf-8" ?>
<!--  D07 – Pickup complete  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Driver"
                x:Class="DryCleaning.Views.Driver.DriverPickupCompletePage"
                x:DataType="vm:DriverPickupCompleteViewModel"
                Title="Pickup Complete">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <Grid RowDefinitions="*,Auto">
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="20" Spacing="16">
                <Border WidthRequest="96" HeightRequest="96" StrokeShape="RoundRectangle 48" StrokeThickness="0"
                        BackgroundColor="{StaticResource SuccessSoft}" HorizontalOptions="Center" Margin="0,24,0,0">
                    <Label Text="📦" FontSize="44" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Items collected!" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding CustomerName, StringFormat='Pickup code verified. {0} has been notified that their items are on the way.'}"
                       Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                        <Label Text="Order" Style="{StaticResource Caption}" />
                        <Label Grid.Column="1" Text="{Binding OrderNumber}" Style="{StaticResource BodyMedium}" HorizontalOptions="End" />
                        <Label Grid.Row="1" Text="Items" Style="{StaticResource Caption}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ItemCountText}" FontSize="14" HorizontalOptions="End" />
                        <Label Grid.Row="2" Text="Next stop" Style="{StaticResource Caption}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProviderName}" FontSize="14" HorizontalOptions="End" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="1" IsVisible="{Binding IsContent}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 24,24,0,0" Padding="20,16,20,24">
            <Button Text="Navigate to Provider" Command="{Binding NavigateToProviderCommand}" />
        </Border>
    </Grid>
</views:BasePage>
