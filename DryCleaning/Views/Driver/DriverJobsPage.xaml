<?xml version="1.0" encoding="utf-8" ?>
<!--  D02 – Jobs (Available / My Jobs / Completed)  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Driver"
                x:Class="DryCleaning.Views.Driver.DriverJobsPage"
                x:DataType="vm:DriverJobsViewModel"
                Title="Jobs">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Border Style="{StaticResource HeroCard}" Margin="20,16,20,0" Padding="20,18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Your next delivery awaits" Style="{StaticResource HeroEyebrow}" />
                <Label Text="Find a job, follow your route, and keep things moving." Style="{StaticResource HeroBody}" />
            </VerticalStackLayout>
        </Border>
        <controls:SegmentBar Grid.Row="1" ItemsSource="{Binding Segments}" />

        <Border Grid.Row="2" Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource WarningSoft}" Margin="20,12,20,0" Padding="14,10"
                IsVisible="{Binding ShowOfflineBanner}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Text="You're offline – go online to see and accept jobs." TextColor="{StaticResource WarningDark}" FontSize="13" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Go online" Style="{StaticResource SmallPrimaryButton}" Command="{Binding GoOnlineCommand}" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="3" IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Jobs}" SelectionMode="None">
                <CollectionView.Header>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="items:DriverJobCardItem">
                        <controls:DriverJobCardView Padding="20,0,20,14" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <controls:PageStateView Grid.Row="3"
                                State="{Binding State}"
                                RetryCommand="{Binding RetryCommand}"
                                ErrorMessage="{Binding ErrorMessage}"
                                EmptyIcon="🚚"
                                EmptyTitle="{Binding EmptyTitle}"
                                EmptyMessage="{Binding EmptyMessage}" />
    </Grid>
</views:BasePage>
