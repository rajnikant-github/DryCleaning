<?xml version="1.0" encoding="utf-8" ?>
<!--  Notifications (shared)  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Provider"
                x:Class="DryCleaning.Views.Provider.NotificationsPage"
                x:DataType="vm:NotificationsViewModel"
                Title="Notifications">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mark all read" Command="{Binding MarkAllReadCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <RefreshView IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.Header>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="items:NotificationItem">
                        <Border Style="{StaticResource Card}" Margin="16,0,16,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsUnread}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource White}">
                                    <Label Text="{Binding Icon}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{DynamicResource Primary}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}" Style="{StaticResource BodyMedium}" FontSize="14" />
                                    <Label Text="{Binding Message}" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding TimeText}" Style="{StaticResource Small}" />
                                </VerticalStackLayout>
                                <Ellipse Grid.Column="2" Fill="{StaticResource AccentBrush}" WidthRequest="10" HeightRequest="10"
                                         VerticalOptions="Start" Margin="0,4,0,0" IsVisible="{Binding IsUnread}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}"
                                EmptyIcon="&#xf0f3;" EmptyTitle="You're all caught up" EmptyMessage="New order and payment alerts will appear here." />
    </Grid>
</views:BasePage>
