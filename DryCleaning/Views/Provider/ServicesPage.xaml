<?xml version="1.0" encoding="utf-8" ?>
<!--  P11 – Services / Catalog: Category → Product  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Provider"
                x:Class="DryCleaning.Views.Provider.ServicesPage"
                x:DataType="vm:CatalogViewModel"
                Title="Services">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Product" Command="{Binding AddProductCommand}">
            <ToolbarItem.IconImageSource>
                <!-- iOS 26 draws text bar buttons dark on glass; as an image the text stays white. -->
                <OnPlatform x:TypeArguments="ImageSource" Default="{x:Null}">
                    <On Platform="iOS"><FontImageSource FontFamily="AppSemibold" Glyph="+ Product" Size="16" Color="White" /></On>
                </OnPlatform>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*">
        <controls:SegmentBar ItemsSource="{Binding Categories}" />

        <RefreshView Grid.Row="1" IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <!--  A plain stack instead of CollectionView: on iOS a CollectionView header/footer is mis-measured after a refresh  -->
            <ScrollView>
                <VerticalStackLayout Padding="16,12,16,24" Spacing="12">
                    <Border Style="{StaticResource SoftPanel}" BackgroundColor="{DynamicResource SecondaryColor}">
                        <Label FontSize="13" TextColor="{DynamicResource Primary}"
                               Text="Categories are managed by E Dry Cleaners. Add Products and Service Items with your own prices." />
                    </Border>
                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Products}">
                        <BindableLayout.EmptyView>
                            <VerticalStackLayout Padding="32,48" Spacing="8">
                        <Label Text="&#xf291;" FontSize="44" HorizontalOptions="Center"  FontFamily="FA" VerticalOptions="Center" TextColor="{DynamicResource Primary}"/>
                        <Label Text="No products yet" Style="{StaticResource H3}" HorizontalOptions="Center" />
                        <Label Text="Add your first product in this category." Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="items:ProductCardItem">
                        <Border Style="{StaticResource Card}" Margin="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Style="{StaticResource IconTile}" WidthRequest="52" HeightRequest="52">
                                    <Label Text="{Binding Icon}" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{DynamicResource Primary}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource BodyMedium}" />
                                    <Label Text="{Binding Description}" Style="{StaticResource Small}" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Small}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding StartingPriceText}" TextColor="{DynamicResource Primary}" FontFamily="AppSemibold" />
                                                <Span Text="  ·  " />
                                                <Span Text="{Binding ServiceItemsText}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="{Binding IsActive}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="+ Add Product" Command="{Binding AddProductCommand}" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:PageStateView Grid.Row="1" State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}"
                                EmptyIcon="&#xf02b;" EmptyTitle="No categories enabled"
                                EmptyMessage="Contact E Dry Cleaners to enable categories for your business." />
    </Grid>
</views:BasePage>
