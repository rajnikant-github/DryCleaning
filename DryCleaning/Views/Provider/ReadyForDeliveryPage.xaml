<?xml version="1.0" encoding="utf-8" ?>
<!--  P09 – Ready for Delivery / Request Driver  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Provider"
                x:Class="DryCleaning.Views.Provider.ReadyForDeliveryPage"
                x:DataType="vm:ReadyForDeliveryViewModel"
                Title="Ready for Delivery">
    <Grid RowDefinitions="*,Auto">
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="24,32,24,16" Spacing="18">
                <Border WidthRequest="96" HeightRequest="96" StrokeThickness="0" StrokeShape="RoundRectangle 48"
                        BackgroundColor="{StaticResource SuccessSoft}" HorizontalOptions="Center">
                    <Label Text="✅" FontSize="44" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Ready for Delivery" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />
                    <Label Text="Cleaned, checked and packed. Request a marketplace driver to deliver it to the customer."
                           Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding OrderNumber, StringFormat='Order #{0}'}" Style="{StaticResource BodyMedium}" VerticalOptions="Center" />
                            <controls:StatusChip Grid.Column="1" Status="{Binding CurrentStatus}" HorizontalOptions="End" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                            <Label Text="Customer" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Text="{Binding CustomerName}" FontSize="14" />
                            <Label Grid.Row="1" Text="Items" Style="{StaticResource Caption}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ItemCountText}" FontSize="14" />
                            <Label Grid.Row="2" Text="Deliver to" Style="{StaticResource Caption}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding DeliveryAddress}" FontSize="14" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--  Searching  -->
                <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource InfoSoft}" IsVisible="{Binding IsSearching}" Padding="16">
                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator IsRunning="{Binding IsSearching}" Color="{StaticResource InfoDark}" WidthRequest="22" HeightRequest="22" />
                        <Label Text="Finding the nearest available driver…" TextColor="{StaticResource InfoDark}" FontSize="14" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!--  Assigned driver  -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasDriver}" Stroke="{StaticResource SuccessBrush}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Delivery driver assigned" Style="{StaticResource SectionLabel}" TextColor="{StaticResource SuccessDark}" Margin="0" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <controls:AvatarView Text="{Binding DriverInitials}" AvatarSize="44" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding DriverName}" Style="{StaticResource BodyMedium}" />
                                <Label Text="{Binding DriverInfo}" Style="{StaticResource Small}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="The driver will collect the order from your store and confirm delivery with the customer's OTP."
                               Style="{StaticResource Small}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="1" IsVisible="{Binding IsContent}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeShape="Rectangle" Padding="16,12,16,20">
            <VerticalStackLayout Spacing="10">
                <Button Text="🚚  Request Driver" Command="{Binding RequestDriverCommand}" IsVisible="{Binding CanRequestDriver}" />
                <Button Text="Back to Orders" Command="{Binding BackToOrdersCommand}" Style="{StaticResource OutlineButton}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:BasePage>
