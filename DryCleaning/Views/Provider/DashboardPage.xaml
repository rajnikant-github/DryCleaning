<?xml version="1.0" encoding="utf-8" ?>
<!--  P02 – Provider Dashboard  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Provider"
                x:Class="DryCleaning.Views.Provider.DashboardPage"
                x:DataType="vm:DashboardViewModel"
                Title="Operations Hub">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Alerts" Command="{Binding OpenNotificationsCommand}" >
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FA" Glyph="&#xf0f3;" Size="20" Color="{StaticResource White}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
        <RefreshView IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="16" Padding="0,0,0,100">

                    <!--  Business greeting and today's operating context  -->
                    <Border Background="{DynamicResource PrimaryGradientBrush}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 0,0,24,24" Padding="20,4,20,22">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Border WidthRequest="30" HeightRequest="30" StrokeThickness="1" Stroke="{StaticResource HeaderOverlayBrush}"
                                        BackgroundColor="{StaticResource HeaderOverlay}" StrokeShape="RoundRectangle 9">
                                    <Label Text="&#xf0f2;" FontFamily="FA" FontSize="15" TextColor="{StaticResource White}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding BusinessName}" TextColor="{StaticResource White}"
                                       FontFamily="AppSemibold" FontSize="14" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="STORE OPERATOR" TextColor="{DynamicResource PrimaryLight}" FontSize="10"
                                   FontFamily="AppSemibold" CharacterSpacing="1.1" Margin="0,3,0,0" />
                            <Label Text="{Binding Greeting}" Style="{StaticResource HeaderTitle}" FontSize="25" />
                            <Label Text="{Binding TodayText}" Style="{StaticResource HeaderCaption}" />
                            <Border IsVisible="{Binding HasUnread}" BackgroundColor="{StaticResource HeaderOverlay}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,6"
                                    HorizontalOptions="Start" Margin="0,8,0,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                                </Border.GestureRecognizers>
                                <Label TextColor="{StaticResource White}" FontSize="13" ><Label.FormattedText><FormattedString><Span Text="&#xf0f3;" FontFamily="FA" /><Span Text="{Binding UnreadText, StringFormat='  {0}'}" /></FormattedString></Label.FormattedText></Label>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!--  At-a-glance order pipeline  -->
                    <Grid Margin="16,-23,16,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFilterCommand}" CommandParameter="New" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Style="{StaticResource IconTile}" BackgroundColor="#EFF6FF">
                                        <Label Text="&#xf0f3;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="#2563EB"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding NewCount}" FontSize="30" FontFamily="AppSemibold"
                                           TextColor="#2563EB" HorizontalOptions="End" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="New Orders" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFilterCommand}" CommandParameter="InProcess" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Style="{StaticResource IconTile}" BackgroundColor="#FFFBEB">
                                        <Label Text="&#xf013;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{StaticResource WarningDark}"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding InProcessCount}" FontSize="30" FontFamily="AppSemibold"
                                           TextColor="{StaticResource WarningDark}" HorizontalOptions="End" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="In Wash / Dry" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFilterCommand}" CommandParameter="Ready" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Style="{StaticResource IconTile}" BackgroundColor="#ECFDF5">
                                        <Label Text="&#xf058;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{StaticResource SuccessDark}"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding ReadyCount}" FontSize="30" FontFamily="AppSemibold"
                                           TextColor="{StaticResource Success}" HorizontalOptions="End" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="Ready for Delivery" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFilterCommand}" CommandParameter="Completed" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Style="{StaticResource IconTile}" BackgroundColor="#F9FAFB">
                                        <Label Text="&#xf466;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="FA" TextColor="{StaticResource MutedForeground}"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding CompletedCount}" FontSize="30" FontFamily="AppSemibold"
                                           TextColor="#4B5563" HorizontalOptions="End" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="Completed" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!--  Always-visible delivery handoff entry point, including when the order queue is empty  -->
                    <Border Style="{StaticResource Card}" Margin="16,0" BackgroundColor="{DynamicResource SecondaryColor}"
                            Stroke="{DynamicResource PrimaryLightBrush}" StrokeThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="{StaticResource HeaderOverlay}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                <Label Text="&#xf0d1;" FontFamily="FA" FontSize="18" TextColor="{DynamicResource Primary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Delivery desk" Style="{StaticResource BodyMedium}" />
                                <Label Text="{Binding ReadyQueueText}" Style="{StaticResource Small}" MaxLines="2" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Review" Style="{StaticResource SmallPrimaryButton}"
                                    Command="{Binding OpenReadyOrdersCommand}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!--  Incoming driver  -->
                    <Border Style="{StaticResource Card}" Margin="16,0" IsVisible="{Binding HasIncomingDriver}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource SecondaryColor}">
                                    <Label Text="&#xf0d1;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="FA" TextColor="{DynamicResource Primary}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Incoming Driver" Style="{StaticResource BodyMedium}" FontSize="14" />
                                    <Label Text="{Binding IncomingDriverText}" Style="{StaticResource Small}" MaxLines="2" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="Receive" Style="{StaticResource SmallPrimaryButton}"
                                        Command="{Binding OpenIncomingCommand}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Today's orders  -->
                    <VerticalStackLayout Padding="16,0" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Today's Orders" Style="{StaticResource H3}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="View all" Style="{StaticResource TextButton}" Command="{Binding ViewAllOrdersCommand}" />
                        </Grid>
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding TodaysOrders}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:OrderCardItem">
                                    <controls:OrderCardView />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoTodaysOrders}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource SecondaryColor}">
                                    <Label Text="&#xf466;" FontFamily="FA" FontSize="18" TextColor="{DynamicResource Primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="No orders today" Style="{StaticResource BodyMedium}" FontSize="14" />
                                    <Label Text="New customer orders will appear here with their next step." Style="{StaticResource Small}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!--  Recent activity  -->
                    <VerticalStackLayout Padding="16,0" Spacing="10">
                        <Label Text="Recent Activity" Style="{StaticResource H3}" />
                        <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoRecentActivity}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource SecondaryColor}">
                                    <Label Text="&#xf1da;" FontFamily="FA" FontSize="18" TextColor="{DynamicResource Primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="Activity will show here" Style="{StaticResource BodyMedium}" FontSize="14" />
                                    <Label Text="Order updates and handoffs appear as your team works." Style="{StaticResource Small}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16,6" IsVisible="{Binding HasRecentActivity}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentActivity}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="items:ActivityItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,10">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse Fill="{DynamicResource PrimaryBrush}" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Text}" FontSize="14" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource Small}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />
    </Grid>
</views:BasePage>
