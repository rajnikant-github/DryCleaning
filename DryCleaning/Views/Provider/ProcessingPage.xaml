<?xml version="1.0" encoding="utf-8" ?>
<!--  P07 – Order Processing  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:models="clr-namespace:DryCleaning.Models"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Provider"
                x:Class="DryCleaning.Views.Provider.ProcessingPage"
                x:DataType="vm:ProcessingViewModel"
                Title="Order Processing">
    <Grid RowDefinitions="*,Auto">
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="16" Spacing="14">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding OrderNumber}" Style="{StaticResource H2}" />
                                <Label Text="{Binding CustomerName}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <controls:StatusChip Grid.Column="1" Status="{Binding Status}" HorizontalOptions="End" VerticalOptions="Start" />
                        </Grid>
                        <Border Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource WarningSoft}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xf013;" FontSize="20" VerticalOptions="Center"  FontFamily="FA" TextColor="{StaticResource WarningDark}" WidthRequest="28" HorizontalTextAlignment="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding StartedText, StringFormat='Processing since {0}'}" TextColor="{StaticResource WarningDark}" FontFamily="AppSemibold" FontSize="13" />
                                    <Label Text="{Binding StatusHint}" TextColor="{StaticResource WarningDark}" FontSize="13" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasInspectionNotes}">
                    <VerticalStackLayout>
                        <Label Text="Inspection notes" Style="{StaticResource SectionLabel}" />
                        <Label Text="{Binding InspectionNotes}" FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="Items to clean" Style="{StaticResource SectionLabel}" />
                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:OrderItemDetail">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding Icon}" FontSize="24" VerticalOptions="Center"  FontFamily="FA" TextColor="{StaticResource Primary}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding ProductName}" Style="{StaticResource BodyMedium}" FontSize="14" />
                                            <Label Text="{Binding Subtitle}" Style="{StaticResource Small}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Quantity, StringFormat='× {0}'}" Style="{StaticResource BodyMedium}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />

        <Border Grid.Row="1" IsVisible="{Binding IsContent}" BackgroundColor="{StaticResource CardColor}"
                Stroke="{StaticResource BorderBrush}" StrokeShape="Rectangle" Padding="16,12,16,20">
            <Grid>
                <Button Text="Mark Quality Check" Command="{Binding MarkQualityCheckCommand}" IsVisible="{Binding IsNotBusy}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="52" />
            </Grid>
        </Border>
    </Grid>
</views:BasePage>
