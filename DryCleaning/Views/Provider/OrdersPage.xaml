<?xml version="1.0" encoding="utf-8" ?>
<!--  Orders tab – includes P03 New Orders (Accept / Reject)  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:items="clr-namespace:DryCleaning.ViewModels.Items"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Provider"
                x:Class="DryCleaning.Views.Provider.OrdersPage"
                x:DataType="vm:OrdersViewModel"
                Title="Orders">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="History" Command="{Binding OpenHistoryCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Spacing="10" Padding="0,0,0,6">
            <Border Style="{StaticResource HeroCard}" Margin="20,16,20,0" Padding="20,18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Order workbench" Style="{StaticResource HeroEyebrow}" />
                        <Label Text="Every order, from arrival to ready for delivery." Style="{StaticResource HeroBody}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Padding="10,6" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Opacity="0.18">
                        <Label Text="Live" Style="{StaticResource HeroBody}" />
                    </Border>
                </Grid>
            </Border>
            <controls:SegmentBar ItemsSource="{Binding Segments}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsVisible="{Binding IsContent}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Orders}" SelectionMode="None">
                <CollectionView.Header>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="items:OrderCardItem">
                        <controls:OrderCardView Padding="20,0,20,14" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <controls:PageStateView Grid.Row="1"
                                State="{Binding State}"
                                RetryCommand="{Binding RetryCommand}"
                                ErrorMessage="{Binding ErrorMessage}"
                                EmptyIcon="📋"
                                EmptyTitle="{Binding EmptyTitle}"
                                EmptyMessage="Orders will appear here as they progress." />
    </Grid>
</views:BasePage>
