<?xml version="1.0" encoding="utf-8" ?>
<!--  Provider Profile  -->
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:DryCleaning.Views"
                xmlns:controls="clr-namespace:DryCleaning.Controls"
                xmlns:vm="clr-namespace:DryCleaning.ViewModels.Provider"
                x:Class="DryCleaning.Views.Provider.ProfilePage"
                x:DataType="vm:ProfileViewModel"
                Title="Profile">
    <Grid>
        <ScrollView IsVisible="{Binding IsContent}">
            <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
                <Border Style="{StaticResource HeroCard}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="YOUR BUSINESS PROFILE" Style="{StaticResource HeroEyebrow}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border WidthRequest="68" HeightRequest="68" BackgroundColor="{StaticResource HeaderOverlay}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 22" VerticalOptions="Start">
                                <Grid>
                                    <Label Text="🧺" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image Source="{Binding LogoSource}" Aspect="AspectFill" IsVisible="{Binding HasLogo}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding BusinessName}" Style="{StaticResource HeroTitle}" FontSize="23" />
                                <Label Text="{Binding Description}" Style="{StaticResource HeroBody}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Business details" Style="{StaticResource SectionLabel}" Margin="0" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Edit" Style="{StaticResource TextButton}" Command="{Binding EditBusinessProfileCommand}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <controls:AvatarView Text="{Binding OwnerInitials}" AvatarSize="40" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding OwnerName}" Style="{StaticResource BodyMedium}" />
                                <Label Text="Owner" Style="{StaticResource Small}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Label Text="{Binding Phone, StringFormat='📞  {0}'}" FontSize="14" />
                        <Label Text="{Binding Email, StringFormat='✉️  {0}'}" FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!--  V1: one address per role  -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Studio address" Style="{StaticResource SectionLabel}" Margin="0" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Edit Address" Style="{StaticResource TextButton}" Command="{Binding EditAddressCommand}" />
                        </Grid>
                        <Label Text="{Binding Address, StringFormat='📍  {0}'}" FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Enabled categories" Style="{StaticResource SectionLabel}" Margin="0" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Manage" Style="{StaticResource TextButton}" Command="{Binding ManageCategoriesCommand}" />
                        </Grid>
                        <Label Text="{Binding CategoriesText}" FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="18,18">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenServicesCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="🏷️" FontSize="18" />
                            <Label Grid.Column="1" Text="Services &amp; Pricing" Style="{StaticResource BodyMedium}" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource MutedForeground}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="18,18">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="🔔" FontSize="18" />
                            <Label Grid.Column="1" Text="Notifications" Style="{StaticResource BodyMedium}" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource MutedForeground}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="18,18">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangePasswordCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="🔑" FontSize="18" />
                            <Label Grid.Column="1" Text="Change Password" Style="{StaticResource BodyMedium}" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource MutedForeground}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="18,18">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding HelpCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="💬" FontSize="18" />
                            <Label Grid.Column="1" Text="Help &amp; Support" Style="{StaticResource BodyMedium}" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource MutedForeground}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Log out" Style="{StaticResource OutlineButton}" TextColor="{StaticResource ErrorDark}" Command="{Binding LogoutCommand}" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:PageStateView State="{Binding State}" RetryCommand="{Binding RetryCommand}" ErrorMessage="{Binding ErrorMessage}" />
    </Grid>
</views:BasePage>
