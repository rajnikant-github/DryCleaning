<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:DryCleaning.Converters"
             x:Class="DryCleaning.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:CurrencyConverter x:Key="Currency" />
            <converters:InvertedBoolConverter x:Key="InvertedBool" />
            <converters:IsNotNullOrEmptyConverter x:Key="HasValue" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
