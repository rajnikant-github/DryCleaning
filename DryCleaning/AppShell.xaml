<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="DryCleaning.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:auth="clr-namespace:DryCleaning.Views.Auth"
       xmlns:onboarding="clr-namespace:DryCleaning.Views.Onboarding"
       xmlns:provider="clr-namespace:DryCleaning.Views.Provider"
       xmlns:customer="clr-namespace:DryCleaning.Views.Customer"
       xmlns:driver="clr-namespace:DryCleaning.Views.Driver"
       Shell.FlyoutBehavior="Disabled"
       Title="EDry Cleaners">

    <!--  Entry flow  -->
    <ShellContent Route="splash" ContentTemplate="{DataTemplate auth:SplashPage}" />
    <ShellContent Route="intro" ContentTemplate="{DataTemplate onboarding:IntroPage}" />
    <ShellContent Route="onboarding" ContentTemplate="{DataTemplate onboarding:OnboardingPage}" />
    <ShellContent Route="roles" ContentTemplate="{DataTemplate auth:RoleSelectionPage}" />
    <ShellContent Route="login" ContentTemplate="{DataTemplate auth:LoginPage}" />

    <!--  Service Provider app  -->
    <TabBar Route="provider">
        <ShellContent Title="Dashboard" Route="dashboard" ContentTemplate="{DataTemplate provider:DashboardPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="FA" Glyph="&#xf015;" Size="22" Color="#6B7280" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Orders" Route="orders" ContentTemplate="{DataTemplate provider:OrdersPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="FA" Glyph="&#xf466;" Size="22" Color="#6B7280" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Services" Route="services" ContentTemplate="{DataTemplate provider:ServicesPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="FA" Glyph="&#xf02b;" Size="22" Color="#6B7280" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Profile" Route="profile" ContentTemplate="{DataTemplate provider:ProfilePage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="FA" Glyph="&#xf007;" Size="22" Color="#6B7280" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

    <!--  Customer app  -->
    <TabBar Route="customer">
        <ShellContent Title="Home" Route="home" ContentTemplate="{DataTemplate customer:CustomerHomePage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="FA" Glyph="&#xf015;" Size="22" Color="#6B7280" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Orders" Route="orders" ContentTemplate="{DataTemplate customer:CustomerOrdersPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="FA" Glyph="&#xf466;" Size="22" Color="#6B7280" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Profile" Route="profile" ContentTemplate="{DataTemplate customer:CustomerProfilePage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="FA" Glyph="&#xf007;" Size="22" Color="#6B7280" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

    <!--  Driver app (shared marketplace drivers)  -->
    <TabBar Route="driver">
        <ShellContent Title="Dashboard" Route="dashboard" ContentTemplate="{DataTemplate driver:DriverDashboardPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="FA" Glyph="&#xf015;" Size="22" Color="#6B7280" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Jobs" Route="jobs" ContentTemplate="{DataTemplate driver:DriverJobsPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="FA" Glyph="&#xf0d1;" Size="22" Color="#6B7280" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Earnings" Route="earnings" ContentTemplate="{DataTemplate driver:DriverEarningsPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="FA" Glyph="&#xf81d;" Size="22" Color="#6B7280" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Profile" Route="profile" ContentTemplate="{DataTemplate driver:DriverProfilePage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="FA" Glyph="&#xf007;" Size="22" Color="#6B7280" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
