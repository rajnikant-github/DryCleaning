<?xml version="1.0" encoding="UTF-8" ?>
<!-- Coral brand system shared by customer, care team and driver experiences. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Brand: use the deeper shade for small text and filled actions. -->
    <Color x:Key="Primary">#FF5E5E</Color>
    <Color x:Key="PrimaryDark">#E74B4A</Color>
    <Color x:Key="PrimaryForeground">#FFFFFF</Color>
    <Color x:Key="PrimaryLight">#FFEAE8</Color>
    <Color x:Key="PrimarySoft">#FFF1F0</Color>
    <Color x:Key="Accent">#E74B4A</Color>
    <Color x:Key="AccentSoft">#FFF1F0</Color>

    <Color x:Key="AppBackground">#FFF7F4</Color>
    <Color x:Key="AppForeground">#1F2937</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSubtle">#FFF4F1</Color>
    <Color x:Key="SecondaryColor">#FFF3F0</Color>
    <Color x:Key="Muted">#F3F5F8</Color>
    <Color x:Key="MutedForeground">#667085</Color>
    <Color x:Key="BorderColor">#F0D7D6</Color>
    <Color x:Key="HeaderOverlay">#40FFFFFF</Color>

    <Color x:Key="Success">#16856B</Color>
    <Color x:Key="SuccessDark">#126B56</Color>
    <Color x:Key="SuccessSoft">#E7F5EF</Color>
    <Color x:Key="Warning">#D99A32</Color>
    <Color x:Key="WarningDark">#926018</Color>
    <Color x:Key="WarningSoft">#FFF5DF</Color>
    <Color x:Key="Error">#C93643</Color>
    <Color x:Key="ErrorDark">#B52D39</Color>
    <Color x:Key="ErrorSoft">#FDECEE</Color>
    <Color x:Key="Info">#327C84</Color>
    <Color x:Key="InfoDark">#27636A</Color>
    <Color x:Key="InfoSoft">#EAF4F5</Color>
    <Color x:Key="Purple">#76609A</Color>
    <Color x:Key="PurpleSoft">#F1EDF7</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="HeaderOverlayBrush" Color="{StaticResource HeaderOverlay}" />
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5E5E" Offset="0" />
        <GradientStop Color="#F25662" Offset="0.55" />
        <GradientStop Color="#D94148" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
