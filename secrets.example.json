{
  "_readme": "Copy to secrets.json (git-ignored) and fill in. One block per environment; Api = the API, Admin = the admin portal, App = keys built into the mobile app (only keys restricted in Google's console belong there). Real environment variables override these values. A property named ...Json keeps an object as raw JSON (paste the Firebase service-account JSON there).",
  "local": {
    "Api": {
      "Paystack": {
        "SecretKey": "sk_test_...",
        "PublicKey": "pk_test_...",
        "CallbackUrl": "http://10.0.2.2:5180/payment-complete.html"
      },
      "Routes": {
        "ApiKey": "AIza... (Routes API, restricted to your server)"
      },
      "Push": {
        "FirebaseCredentialsJson": {
          "type": "service_account",
          "project_id": "...",
          "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",
          "client_email": "..."
        }
      },
      "ApnsSettings": {
        "PrivateKey": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
      },
      "Email": {
        "Key": "SG.\u2026 (SendGrid API key, optional \u2013 used first when set)",
        "SmtpServer": "smtp.office365.com",
        "Port": 587,
        "Username": "mailbox@yourdomain (SMTP login, used when no SendGrid key)",
        "Password": "\u2026",
        "From": "sender address (verified in SendGrid, or the mailbox)",
        "Name": "E Dry Cleaners"
      }
    },
    "Admin": {},
    "App": {
      "GoogleMaps": {
        "ApiKey": "AIza... (restricted to the app)",
        "UseSampleAddresses": true
      }
    }
  },
