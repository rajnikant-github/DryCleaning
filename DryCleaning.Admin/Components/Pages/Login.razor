@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout

<PageTitle>Sign in – E Dry Cleaners Admin</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <img src="images/logo.png" alt="E Dry Cleaners" class="login-logo" />
        <h1>E Dry Cleaners</h1>
        <p class="muted">Administrator sign-in</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="notice bad">@Error</div>
        }

        <form method="post" action="/auth/login">
            <AntiforgeryToken />
            <label class="field">
                <span>Email</span>
                <input name="identifier" type="email" autocomplete="username" required autofocus />
            </label>
            <label class="field">
                <span>Password</span>
                <input name="password" type="password" autocomplete="current-password" required />
            </label>
            <button class="btn" type="submit">Sign in</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }
}
