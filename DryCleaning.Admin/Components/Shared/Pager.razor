@if (TotalPages > 1)
{
    <div class="pager">
        <button class="btn btn-light btn-sm" disabled="@(Page <= 1)" @onclick="() => Go(Page - 1)">‹ Previous</button>
        <span>Page @Page of @TotalPages</span>
        <button class="btn btn-light btn-sm" disabled="@(Page >= TotalPages)" @onclick="() => Go(Page + 1)">Next ›</button>
    </div>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private Task Go(int page) => PageChanged.InvokeAsync(page);
}
